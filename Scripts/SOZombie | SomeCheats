--[[
Sorry for soo small script :<
--]]
local rs = game:GetService("ReplicatedStorage")
local Rayfield = loadstring(game:HttpGet("https://github.com/UnknownDeveloper-sqd/UnknownSquad-RayField-Lib/raw/refs/heads/main/Rayfield/CustomRayfield.luau"))()

local Window = Rayfield:CreateWindow({
    Name = "SOZombie | SomeCheats",
    LoadingTitle = "SOZombie | SomeCheats",
    LoadingSubtitle = "By: UnknownSquad",
    Theme = "Amethyst",
    Width = 460,
    Height = 360,
    Font = "Code",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local mainTab = Window:CreateTab("Main")

local morphs = {}
for _, v in ipairs(rs.Morphs:GetChildren()) do
    if v:IsA("Model") then table.insert(morphs, v.Name) end
end
table.sort(morphs)

local morphChoice = morphs[1]
mainTab:CreateDropdown({
    Name = "Select Morph",
    Options = morphs,
    CurrentOption = {morphs[1]},
    MultipleOptions = false,
    Callback = function(opt)
        morphChoice = type(opt) == "table" and opt[1] or opt
    end
})

mainTab:CreateButton({
    Name = "Change Morph",
    Callback = function()
        local m = rs.Morphs:FindFirstChild(morphChoice)
        if m then
            rs.CharChange:FireServer(m)
        end
    end
})
mainTab:CreateParagraph({
    Title = "",
    Content = ""
})
local npcMap = {}
local npcs = {}
for _, v in ipairs(rs:GetDescendants()) do
    if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and not v:IsDescendantOf(rs.Morphs) then
        if not npcMap[v.Name] then
            npcMap[v.Name] = v
            table.insert(npcs, v.Name)
        end
    end
end
table.sort(npcs)

local npcChoice = npcs[1]
mainTab:CreateDropdown({
    Name = "Select NPC",
    Options = npcs,
    CurrentOption = {npcs[1]},
    MultipleOptions = false,
    Callback = function(opt)
        npcChoice = type(opt) == "table" and opt[1] or opt
    end
})

mainTab:CreateButton({
    Name = "Change Morph",
    Callback = function()
        local m = npcMap[npcChoice]
        if m then
            rs.CharChange:FireServer(m)
        end
    end
})
