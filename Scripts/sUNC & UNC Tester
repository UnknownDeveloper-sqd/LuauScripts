local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local function getAnyScript()
	local scr = game:FindFirstChildWhichIsA("LocalScript", true) or game:FindFirstChildWhichIsA("ModuleScript", true)
	if not scr and lp then
		local ps = lp:FindFirstChild("PlayerScripts")
		if ps then scr = ps:FindFirstChildWhichIsA("LocalScript", true) or ps:FindFirstChildWhichIsA("ModuleScript", true) end
	end
	return scr
end

local function G(p)
	local parts = string.split(p, ".")
	local root = parts[1]
	local t
	local ok, env = pcall(function()
		return (type(getgenv) == "function" and getgenv()) or nil
	end)
	if ok and type(env) == "table" and env[root] ~= nil then
		t = env[root]
	end
	if t == nil then
		local ok0, f0 = pcall(getfenv, 0)
		if ok0 and type(f0) == "table" and f0[root] ~= nil then
			t = f0[root]
		end
	end
	if t == nil then
		local ok1, f1 = pcall(getfenv, 1)
		if ok1 and type(f1) == "table" and f1[root] ~= nil then
			t = f1[root]
		end
	end
	if t == nil and type(_G) == "table" and _G[root] ~= nil then
		t = _G[root]
	end
	if t == nil and type(shared) == "table" and shared[root] ~= nil then
		t = shared[root]
	end
	if t == nil then
		if root == "debug" then t = debug
		elseif root == "table" then t = table
		elseif root == "coroutine" then t = coroutine
		end
	end
	if #parts == 1 then return t end
	for i = 2, #parts do
		if type(t) ~= "table" then return nil end
		t = t[parts[i]]
	end
	return t
end

local db = {"Volt","Potassium","Wave","Synapse Z","Madium","Real","Isaeva","Velocity","Volcano","Cosmic","SirHurt","Solara","Xeno","MacSploit","Opiumware","Delta","Vega X","Codex"}
local getEx = G("identifyexecutor") or G("getexecutorname") or G("whatexecutor")
local id = "Unknown"
if getEx then
	local ok, res = pcall(getEx)
	if ok and type(res) == "string" then id = res end
end

local target = id
local found = false
for _, v in db do
	if string.find(string.lower(tostring(id)), string.lower(v)) then
		target = v
		found = true
		break
	end
end

local totalPassed, totalTests = 0, 0
local sleep = (task and task.wait) or wait

local function runCat(tag, list)
	print("  " .. tag .. ":")
	local p = 0
	for _, t in list do
		local n, f = t[1], t[2]
		local ok, r = pcall(f)
		if ok and r == true then
			p += 1
			totalPassed += 1
			print("    PASS: " .. n)
		elseif ok and r == nil then
			warn("    MISSING: " .. n)
		else
			local err = not ok and (" (" .. tostring(r) .. ")") or ""
			print("    FAIL: " .. n .. err)
		end
		totalTests += 1
		sleep(0.015)
	end
	print(string.format("    Score: %d%% (%d/%d)", math.floor((p / #list) * 100), p, #list))
end

