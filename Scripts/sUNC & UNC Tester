local env = (type(getgenv) == "function" and getgenv()) or _G
local function G(p)
	local t = env;
	for s in p:gmatch("[^%.]+") do if type(t) ~= "table" then return end; t = t[s]; end;
	return t;
end;

local db = {"Volt","Potassium","Wave","Synapse Z","Madium","Real","Isaeva","Velocity","Volcano","Cosmic","SirHurt","Solara","Xeno","MacSploit","Opiumware","Delta","Vega X","Codex"}
local getEx = G("identifyexecutor") or G("getexecutorname") or G("whatexecutor")
local id = "Unknown"
if getEx then
	local ok, res = pcall(getEx)
	if ok and type(res) == "string" then id = res; end;
end;

local target = id
for _, v in db do
	if string.find(string.lower(tostring(id)), string.lower(v)) then
		target = v;
		break;
	end;
end;

local function runCat(tag, list)
	print("  " .. tag .. ":")
	local p = 0
	for _, t in list do
		local n, f = t[1], t[2]
		local ok, r = pcall(f)
		if ok and r == true then
			p += 1;
			print("    PASS: " .. n)
		elseif ok and r == nil then
			warn("    MISSING: " .. n)
		else
			print("    FAIL: " .. n)
		end;
		task.wait(0.02)
	end;
	print(string.format("    Score: %d%% (%d/%d)", math.floor((p / #list) * 100), p, #list))
end;

task.spawn(function()
	print("\n[" .. tostring(target) .. "]:")
	runCat("sUNC", {
		{"identifyexecutor", function() local f = G("identifyexecutor") or G("getexecutorname"); return f and type(f()) == "string" end},
		{"readfile & writefile", function() local r, w = G("readfile"), G("writefile"); if not (r and w) then return end; w("_s.txt", "1"); local ok = r("_s.txt") == "1"; pcall(G("delfile"), "_s.txt"); return ok end},
		{"appendfile", function() local r, w, a = G("readfile"), G("writefile"), G("appendfile"); if not (r and w and a) then return end; w("_s.txt", "a"); a("_s.txt", "b"); local ok = r("_s.txt") == "ab"; pcall(G("delfile"), "_s.txt"); return ok end},
		{"makefolder & isfolder", function() local m, i = G("makefolder"), G("isfolder"); if not (m and i) then return end; m("_f"); local ok = i("_f") and not i("_f_x"); pcall(G("delfolder"), "_f"); return ok end},
		{"delfolder", function() local m, d, i = G("makefolder"), G("delfolder"), G("isfolder"); if not (m and d and i) then return end; m("_f"); d("_f"); return not i("_f") end},
		{"listfiles", function() local l, m, w = G("listfiles"), G("makefolder"), G("writefile"); if not (l and m and w) then return end; m("_l"); w("_l/1.txt", "x"); local ok = #l("_l") > 0; pcall(G("delfile"), "_l/1.txt"); pcall(G("delfolder"), "_l"); return ok end},
		{"crypt.base64", function() local e, d = G("crypt.base64encode") or G("base64.encode"), G("crypt.base64decode") or G("base64.decode"); return e and d and d(e("sUNC")) == "sUNC" end},
		{"crypt.hash", function() local h = G("crypt.hash") or G("crypto.hash"); return h and type(h("x", "sha256")) == "string" end},
		{"crypt.generatekey", function() local g = G("crypt.generatekey") or G("crypto.generatekey"); return g and type(g()) == "string" end},
		{"hookfunction", function() local h = G("hookfunction"); if not h then return end; local fn = function() return 1 end; local o = h(fn, function() return 2 end); local ok = fn() == 2; h(fn, o); return ok end},
		{"hookmetamethod", function() local h = G("hookmetamethod"); if not h then return end; local t = setmetatable({}, {__index = function() return 1 end}); local o = h(t, "__index", function() return 2 end); local ok = t.a == 2; h(t, "__index", o); return ok end},
		{"newcclosure", function() local n = G("newcclosure"); if not n then return end; local c = n(function() return 1 end); return type(c) == "function" and c() == 1 end},
		{"clonefunction", function() local c = G("clonefunction"); return c and c(print) ~= print end},
		{"checkcaller", function() local c = G("checkcaller"); return c and c() == true end},
		{"threadidentity", function() local g, s = G("getthreadidentity"), G("setthreadidentity"); if not (g and s) then return end; local o = g(); s(3); local ok = g() == 3; s(o); return ok end},
		{"Drawing", function() local d, r = G("Drawing.new"), G("isrenderobj"); if not (d and r) then return end; local o = d("Square"); local ok = r(o); pcall(function() o:Remove() end); return ok end},
		{"request", function() local r = G("request") or G("http_request") or G("syn.request"); return r and r({Url = "https://httpbin.org/get", Method = "GET"}).StatusCode == 200 end},
		{"decompile", function() return type(G("decompile")) == "function" end},
		{"raknet", function() local r = G("raknet") or G("Raknet"); return type(r) == "table" or type(r) == "function" end}
	})
	runCat("UNC", {
		{"getgenv", function() local f = G("getgenv"); return f and type(f()) == "table" end},
		{"getrenv", function() local f = G("getrenv"); return f and type(f()) == "table" and f().print ~= nil end},
		{"getreg", function() local f = G("getreg") or G("debug.getregistry"); return f and type(f()) == "table" end},
		{"getgc", function() local f = G("getgc"); return f and #f() > 0 end},
		{"getloadedmodules", function() local f = G("getloadedmodules"); return f and type(f()) == "table" end},
		{"getrunningscripts", function() local f = G("getrunningscripts") or G("getscripts"); return f and type(f()) == "table" end},
		{"getinstances", function() local f = G("getinstances"); return f and #f() > 0 end},
		{"getnilinstances", function() local f = G("getnilinstances"); return f and type(f()) == "table" end},
		{"islclosure", function() local f = G("islclosure"); return f and f(function() end) and not f(print) end},
		{"iscclosure", function() local f = G("iscclosure"); return f and f(print) and not f(function() end) end},
		{"getrawmetatable", function() local f = G("getrawmetatable"); return f and type(f(game)) == "table" end},
		{"setrawmetatable", function() local s = G("setrawmetatable"); if not s then return end; local t: any, m: any = setmetatable({}, {}), {}; s(t, m); return getmetatable(t) == m end},
		{"readonly", function() local s, i = G("setreadonly"), G("isreadonly"); if not (s and i) then return end; local t = {}; s(t, true); local ok = i(t); s(t, false); return ok and not i(t) end},
		{"getnamecallmethod", function() return type(G("getnamecallmethod")) == "function" end},
		{"HttpGet", function() local s = game:HttpGet("https://httpbin.org/get"); return type(s) == "string" and #s > 0 end},
		{"debug.constants", function() local c = G("debug.getconstants"); return c and #c(function() return "const_a", "const_b" end) >= 2 end},
		{"debug.upvalues", function() local g, s = G("debug.getupvalue"), G("debug.setupvalue"); if not (g and s) then return end; local v = 1; local function fn() v += 1; return v; end; v = 2; s(fn, 1, 9); return g(fn, 1) == 9 end},
		{"debug.setconstant", function() local s = G("debug.setconstant"); if not s then return end; local fn = function() return "a" end; s(fn, 1, "b"); return fn() == "b" end},
		{"debug.getinfo", function() local f = G("debug.getinfo"); return f and type(f(function() end)) == "table" end},
		{"debug.protos", function() local p = G("debug.getprotos"); if not p then return end; local function fn() local function a() end; local function b() end; end; return #p(fn) >= 2 end},
		{"debug.getstack", function() local f = G("debug.getstack"); if not f then return end; local s; (function() local x = 1; s = f(1); end)(); return type(s) == "table" end},
		{"setclipboard", function() local f = G("setclipboard") or G("toclipboard"); if not f then return end; f("ok"); return true end},
		{"isrbxactive", function() local f = G("isrbxactive") or G("isgameactive"); return f and type(f()) == "boolean" end},
		{"fpscap", function() local g, s = G("getfpscap"), G("setfpscap"); if not (g and s) then return end; s(60); return type(g()) == "number" end},
		{"cloneref", function() local c = G("cloneref"); if not c then return end; local p = Instance.new("Part"); return c(p) ~= p end},
		{"queue_on_teleport", function() return type(G("queue_on_teleport") or G("queueonteleport")) == "function" end},
		{"mouse1click", function() return type(G("mouse1click")) == "function" end},
		{"keypress", function() return type(G("keypress")) == "function" end}
	})
	print("")
end)
