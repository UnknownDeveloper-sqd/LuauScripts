local Rayfield = loadstring(game:HttpGet("https://raw.githubusercontent.com/UnknownDeveloper-sqd/UnknownSquad-RayField-Lib/refs/heads/main/Rayfield/CustomRayfield.luau"))()

local Window = Rayfield:CreateWindow({
    Name = "FSMorph 2 | SomeCheats",
    LoadingTitle = "FSMorph 2 | SomeCheats",
    LoadingSubtitle = "By: UnknownSquad",
    Theme = "Amethyst",
    Width = 460,
    Height = 360,
    Font = "Code",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local lp = game.Players.LocalPlayer
local sel = "sans"
local auto = false
local target = nil

