local pg = lp:WaitForChild("PlayerGui")
local pos = pg:WaitForChild("GuiThatShowsPosition")
local opVal = pos:WaitForChild("Has404")

local function addOpChars()
    pcall(function()
        for name, data in pairs(opData) do
            charData[name] = data
            if not table.find(charList, name) then
                table.insert(charList, name)
            end
        end
    end)
end

if opVal.Value == true then
    addOpChars()
end

local Tab = Window:CreateTab("Main")

local prog = Tab:CreateProgress({
    Name = "Resets Progress",
    Progress = 0
})

local function getResets()
    local val = 0
    pcall(function()
        local pgui = lp:FindFirstChild("PlayerGui")
        local ppos = pgui and pgui:FindFirstChild("GuiThatShowsPosition")
        if not ppos then return end
        if sel == "sans" and ppos:FindFirstChild("Resets404") then
            val = ppos.Resets404.Value
            return
        end
        local r = ppos:FindFirstChild("Resets")
        if r then
            val = r.Value
        end
    end)
    return val
end

local function updateUI()
    pcall(function()
        local cur = getResets()
        local maxT = target or 202
        local ratio = math.clamp(cur / maxT, 0, 1)
        prog:Set(ratio)
    end)
end

updateUI()

local Drop = Tab:CreateDropdown({
    Name = "Select Character",
    Options = charList,
    CurrentOption = {"sans"},
    MultiSelection = false,
    Callback = function(opt)
        pcall(function()
            sel = typeof(opt) == "table" and opt[1] or opt
            updateUI()
        end)
    end
})

opVal.Changed:Connect(function(v)
    pcall(function()
        if v == true then
            addOpChars()
            if Drop and Drop.Refresh then
                Drop:Refresh(charList)
            end
        end
    end)
end)

Tab:CreateInput({
    Name = "Target Resets",
    PlaceholderText = "0000",
    RemoveTextAfterFocusLost = false,
    Callback = function(txt)
        pcall(function()
            target = tonumber(txt)
            updateUI()
        end)
    end
})

local function isMorphed(c)
    local bp = lp:FindFirstChild("Backpack")
    if bp and #bp:GetChildren() > 0 then return true end
    if c then
        if c:FindFirstChildOfClass("Tool") then return true end
        if c:FindFirstChild("Headz") or c:FindFirstChild("Chest") or c:FindFirstChild("SansAnim") or c:FindFirstChild("KR") then
            return true
        end
    end
    return false
end

Tab:CreateButton({
    Name = "Morph",
    Callback = function()
        pcall(function()
            local pgui = lp:FindFirstChild("PlayerGui")
            local gui = pgui and pgui:FindFirstChild("SelectCharacterGui")
            local frame = gui and gui:FindFirstChild("Frame")
            local ev = frame and frame:FindFirstChild("RemoteEvent")
            if ev then
                local data = charData[sel] or {id = sel}
                ev:FireServer(data.id, data.op and true or nil)
            end
        end)
    end
})

local Toggle

local function loop()
    while auto do
        pcall(function()
            local cur = getResets()
            updateUI()
            if target and cur >= target then
                auto = false
                if Toggle and Toggle.Set then
                    Toggle:Set(false)
                end
                return
            end
            local char = lp.Character or lp.CharacterAdded:Wait()
            local hum = char:WaitForChild("Humanoid", 10)
            local root = char:WaitForChild("HumanoidRootPart", 10)
            if not hum or hum.Health <= 0 then
                lp.CharacterAdded:Wait()
                return
            end
            task.wait(0.4)
            local pgui = lp:FindFirstChild("PlayerGui")
            local gui = pgui and pgui:FindFirstChild("SelectCharacterGui")
            local frame = gui and gui:FindFirstChild("Frame")
            local ev = frame and frame:FindFirstChild("RemoteEvent")
            local t0 = os.clock()
            while auto and not isMorphed(char) and os.clock() - t0 < 6 do
                if ev then
                    local data = charData[sel] or {id = sel}
                    ev:FireServer(data.id, data.op and true or nil)
                end
                task.wait(0.3)
            end
            if not auto then return end
            task.wait(0.4)
            if hum and hum.Health > 0 then
                hum.Health = 0
            end
            lp.CharacterAdded:Wait()
            task.wait(0.3)
            updateUI()
        end)
        task.wait(0.1)
    end
end

Toggle = Tab:CreateToggle({
    Name = "Auto Reset",
    CurrentValue = false,
    Callback = function(v)
        pcall(function()
            auto = v
            if auto then
                task.spawn(loop)
            end
        end)
    end
})
