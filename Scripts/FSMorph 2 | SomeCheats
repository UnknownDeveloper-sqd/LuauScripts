local charList = {
    "sans", "fell sans", "outer sans", "swap sans", "dust sans",
    "science sans", "horror sans", "killer sans", "geno sans", "photo sans",
    "steam sans", "2D sans", "insanity sans", "negatale sans", "bird sans",
