--[[ it's opensource :>     ]]--
--[[ UI Lib: CustomRayfield ]]--
local Rayfield = loadstring(game:HttpGet("https://github.com/UnknownDeveloper-sqd/UnknownSquad-RayField-Lib/raw/refs/heads/main/Rayfield/CustomRayfield.luau"))()

local Window = Rayfield:CreateWindow({
    Name = "Antpocalypse | SomeCheats",
    LoadingTitle = "Antpocalypse | SomeCheats",
    LoadingSubtitle = "By: UnknownSquad",
    Theme = "Amethyst",
    Width = 460,
    Height = 360,
    Font = "Code",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local KillTab = Window:CreateTab("Kill")
local PlayerTab = Window:CreateTab("Player")
local WeaponTab = Window:CreateTab("Weapon")
local MiscTab = Window:CreateTab("Misc")

local plrs, rs, uis = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("UserInputService")
local lp, mouse = plrs.LocalPlayer, plrs.LocalPlayer:GetMouse()
local Network = require(rs:WaitForChild("Packages"):WaitForChild("Network"))

local kill, heal, firerate, firerateVal, noSpread, infAmmo, healBuild = false, false, false, 6000, false, false, false
local targets = {"Bots", "Buildings"}
local origCfg = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isAlive()
    local char = lp.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    return true, char, hum, root
end

local function hasTarget(name)
    if type(targets) == "table" then
        for k, v in pairs(targets) do
            if v == name or (k == name and v == true) then return true end
        end
    elseif type(targets) == "string" then
        return targets == name
    end
    return false
end

local function getDigTarget()
    local alive, char, _, root = isAlive()
    if not alive then return end
    rayParams.FilterDescendantsInstances = {char}
    local res = workspace:Raycast(mouse.UnitRay.Origin, mouse.UnitRay.Direction * 1000, rayParams)
    local hitPos = if mouse.Hit then mouse.Hit.Position else mouse.UnitRay.Origin + mouse.UnitRay.Direction * 10
    local pos = res and res.Position or hitPos
    local mat = res and res.Material or Enum.Material.Ground
    local diff = pos - root.Position
    local targetPos = if diff.Magnitude > 9 then root.Position + diff.Unit * 8 else pos
    return targetPos, mat
end

local function dig(mode)
    local pos, mat = getDigTarget()
    if pos and mat then
        Network:FireServer("PlayerWantsToDig", pos, mode, mat)
    end
end

KillTab:CreateParagraph({
    Title = "Warning",
    Content = "Killing players will result in a ban. Only Bots and Buildings are safe to target."
})

KillTab:CreateToggle({
    Name = "Kill",
    CurrentValue = false,
    Flag = "KillToggle",
    Callback = function(v) kill = v end
})

KillTab:CreateDropdown({
    Name = "Target Selector",
    Options = {"Bots", "Buildings"},
    CurrentOption = {"Bots", "Buildings"},
    MultipleOptions = true,
    Flag = "TargetDropdown",
    Callback = function(v) targets = v end
})

PlayerTab:CreateToggle({
    Name = "Insta-Heal",
    CurrentValue = false,
    Flag = "InstaHealToggle",
    Callback = function(v) heal = v end
})

WeaponTab:CreateSection("Weapons")

WeaponTab:CreateToggle({
    Name = "FirerateBoost",
    CurrentValue = false,
    Flag = "FirerateToggle",
    Callback = function(v) firerate = v end
})

WeaponTab:CreateSlider({
    Name = "Firerate Value",
    Range = {100, 10000},
    Increment = 100,
    Suffix = "",
    CurrentValue = 6000,
    Flag = "FirerateSlider",
    Callback = function(v) firerateVal = v end
})

WeaponTab:CreateToggle({
    Name = "NoSpread",
    CurrentValue = false,
    Flag = "NoSpreadToggle",
    Callback = function(v) noSpread = v end
})

WeaponTab:CreateToggle({
    Name = "InfAmmo",
    CurrentValue = false,
    Flag = "InfAmmoToggle",
    Callback = function(v) infAmmo = v end
})

WeaponTab:CreateSection("Buildings")

WeaponTab:CreateToggle({
    Name = "Insta Heal Buildings",
    CurrentValue = false,
    Flag = "InstaHealBuildingsToggle",
    Callback = function(v) healBuild = v end
})

local digBind = MiscTab:CreateKeybind({
    Name = "Mouse Dig",
    CurrentKeybind = "T",
    HoldToInteract = false,
    Flag = "DigKeybind",
    Callback = function() pcall(dig, "Subtract") end
})

local placeBind = MiscTab:CreateKeybind({
    Name = "Mouse Place",
    CurrentKeybind = "G",
    HoldToInteract = false,
    Flag = "PlaceKeybind",
    Callback = function() pcall(dig, "Add") end
})

local function toKey(k)
    if typeof(k) == "EnumItem" then return k end
    if typeof(k) == "string" then
        local ok, res = pcall(function() return (Enum.KeyCode::any)[k] or (Enum.UserInputType::any)[k] end)
        if ok and res then return res end
    end
    return nil
end

local function getKey(bind, flagName, def)
    local k = toKey(bind and (bind.value or bind.CurrentKeybind))
    if k then return k end
    local f = Rayfield.Flags and Rayfield.Flags[flagName]
    local fk = toKey(f and (f.CurrentValue or f.value or f.CurrentKeybind or f))
    if fk then return fk end
    return def
end

local function isKeyDown(k)
    if not k or k == Enum.KeyCode.Unknown then return false end
    if k.EnumType == Enum.KeyCode then return uis:IsKeyDown(k) end
    if k.EnumType == Enum.UserInputType then return uis:IsMouseButtonPressed(k) end
    return false
end

task.spawn(function()
    while true do
        task.wait(0.05)
        if isAlive() and not uis:GetFocusedTextBox() then
            if isKeyDown(getKey(digBind, "DigKeybind", Enum.KeyCode.T)) then pcall(dig, "Subtract") end
            if isKeyDown(getKey(placeBind, "PlaceKeybind", Enum.KeyCode.G)) then pcall(dig, "Add") end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait()
        local alive, char, hum, root = isAlive()
        if not alive then continue end
        local tool = char:FindFirstChildOfClass("Tool")
        local shootPart = tool and (tool:FindFirstChild("ShootPart") or tool:FindFirstChild("ShootPart", true))
        local isGun = tool and tool.Name ~= "Breaker" and shootPart and (tool:GetAttribute("IsGun") == true or tool:FindFirstChild("Config"))
        local myTeam = lp.Team
        local myTeamName = myTeam and myTeam.Name
        local enemyTeam = myTeamName and ((myTeamName == "Black" and "Red") or (myTeamName == "Red" and "Black"))

        if kill and tool and isGun and shootPart then
            pcall(function()
                local origin = shootPart.Position
                local now = tick()

                if hasTarget("Bots") then
                    local f = workspace:FindFirstChild("CharactersSpawned")
                    local npcs = f and f:FindFirstChild("Npcs")
                    if npcs then
                        for _, tf in ipairs(npcs:GetChildren()) do
                            if not enemyTeam or tf.Name == enemyTeam or not tf:IsA("Folder") then
                                local bots = if tf:IsA("Model") then {tf} else tf:GetChildren()
                                for _, m in ipairs(bots) do
                                    if m:IsA("Model") then
                                        local ehum = m:FindFirstChildOfClass("Humanoid")
                                        local head = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildOfClass("BasePart")
                                        if head and ehum and ehum.Health > 0 then
                                            local targetPos = head.Position
                                            local dir = targetPos - origin
                                            local unit = if dir.Magnitude > 0 then dir.Unit else Vector3.new(0, 1, 0)
                                            for _ = 1, 3 do
                                                Network:FireServer("RequestFire", tool, targetPos, origin, unit, nil, now)
                                                Network:FireServer("ClientHitCharacter", tool, origin, targetPos, m, head, "Bullet", unit)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                if hasTarget("Buildings") then
                    local cf = workspace:FindFirstChild("Constructed Items Folder")
                    if cf then
                        for _, uf in ipairs(cf:GetChildren()) do
                            local items = if #uf:GetChildren() > 0 then uf:GetChildren() else {uf}
                            for _, item in ipairs(items) do
                                local tTeam = item:GetAttribute("Team")
                                if not myTeamName or not tTeam or tTeam ~= myTeamName then
                                    local ehum = item:FindFirstChildOfClass("Humanoid")
                                    local hit = item:FindFirstChild("Head") or item:FindFirstChild("Hitbox") or item:FindFirstChild("HumanoidRootPart") or item:FindFirstChildOfClass("BasePart")
                                    if ehum and hit and ehum.Health > 0 then
                                        local targetPos = hit.Position
                                        local dir = targetPos - origin
                                        local unit = if dir.Magnitude > 0 then dir.Unit else Vector3.new(0, 1, 0)
                                        for _ = 1, 3 do
                                            Network:FireServer("RequestFire", tool, targetPos, origin, unit, nil, now)
                                            Network:FireServer("ClientHitCharacter", tool, origin, targetPos, item, hit, "Bullet", unit)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end

        if heal then
            pcall(function()
                char:SetAttribute("HasMedicPassive", true)
                Network:FireServer("PassiveMedicHeal", hum)
                if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
                local bp = lp:FindFirstChild("Backpack")
                for _, c in ipairs({char, bp}) do
                    if c then
                        for _, t in ipairs(c:GetChildren()) do
                            if t:IsA("Tool") and t.Name ~= "Breaker" and t:GetAttribute("DamageBlock") ~= nil then
                                t:SetAttribute("DamageBlock", 99999)
                                t:SetAttribute("MaxDamageBlock", 99999)
                            end
                        end
                    end
                end
                Network:FireServer("RegenBlock", 99999)
            end)
        end

        pcall(function()
            local bp = lp:FindFirstChild("Backpack")
            for _, cont in ipairs({char, bp}) do
                if cont then
                    for _, t in ipairs(cont:GetChildren()) do
                        if t:IsA("Tool") and t.Name ~= "Breaker" and (t:GetAttribute("IsGun") == true or t:FindFirstChild("ShootPart") or t:FindFirstChild("Config")) then
                            local cfg = t:FindFirstChild("Config")
                            if cfg and cfg:IsA("ModuleScript") then
                                local ok, c = pcall(require, cfg)
                                if ok and type(c) == "table" then
                                    if not origCfg[t] then
                                        origCfg[t] = {
                                            Rpm = c.Rpm,
                                            Spread = c.Spread,
                                            MaxSpread = c.MaxSpread,
                                            Recoil = c.Recoil,
                                            MagSize = c.MagSize,
                                            Ammo = c.Ammo
                                        }
                                    end
                                    local o = origCfg[t]
                                    c.Rpm = if firerate then firerateVal else (o.Rpm or c.Rpm)
                                    c.Spread = if noSpread then 0 else (o.Spread or c.Spread)
                                    c.MaxSpread = if noSpread then 0 else (o.MaxSpread or c.MaxSpread)
                                    c.Recoil = if noSpread then 0 else (o.Recoil or c.Recoil)
                                    c.MagSize = if infAmmo then 99999 else (o.MagSize or c.MagSize)
                                    c.Ammo = if infAmmo then 99999 else (o.Ammo or c.Ammo)
                                    if infAmmo then
                                        t:SetAttribute("Mag", 99999)
                                        t:SetAttribute("Ammo", 99999)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)

        if healBuild then
            pcall(function()
                local cf = workspace:FindFirstChild("Constructed Items Folder")
                if cf then
                    local myTeam = lp.Team
                    local myTeamName = myTeam and myTeam.Name
                    for _, uf in ipairs(cf:GetChildren()) do
                        local items = if #uf:GetChildren() > 0 then uf:GetChildren() else {uf}
                        for _, item in ipairs(items) do
                            local tTeam = item:GetAttribute("Team")
                            if not myTeamName or not tTeam or tTeam == myTeamName then
                                local bHum = item:FindFirstChildOfClass("Humanoid")
                                if bHum and bHum.Health > 0 and bHum.Health < bHum.MaxHealth then
                                    Network:FireServer("RepairBuilding", item, 99999)
                                    bHum.Health = bHum.MaxHealth
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
