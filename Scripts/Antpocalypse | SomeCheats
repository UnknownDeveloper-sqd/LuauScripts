local Rayfield = loadstring(game:HttpGet("https://github.com/UnknownDeveloper-sqd/UnknownSquad-RayField-Lib/raw/refs/heads/main/Rayfield/CustomRayfield.luau"))()
loadstring(game:HttpGet("https://gist.github.com/UnknownDeveloper-sqd/6b45501daf7aeeaf96f746684591f301/raw/1af59e70343e582948c62f987eb1c4026a052dd6/Script"))()

local Window = Rayfield:CreateWindow({
    Name = "Antpocalypse | SomeCheats",
    LoadingTitle = "Antpocalypse | SomeCheats",
    LoadingSubtitle = "By: UnknownSquad",
    Theme = "Amethyst",
    Width = 460,
    Height = 360,
    Font = "Code",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local KillTab, PlayerTab, WeaponTab, MiscTab = Window:CreateTab("Kill"), Window:CreateTab("Player"), Window:CreateTab("Weapon"), Window:CreateTab("Misc")
local plrs, rs, uis = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("UserInputService")
local lp, mouse = plrs.LocalPlayer, plrs.LocalPlayer:GetMouse()
local Network = require(rs:WaitForChild("Packages"):WaitForChild("Network") :: ModuleScript)

local kill, heal, firerate, firerateVal, noSpread, infAmmo = false, false, false, 6000, false, false
local targets, digging, placing, digKey, placeKey = {"Bots", "Players", "Buildings"}, false, false, "T", "G"

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local m = getnamecallmethod()
    if not checkcaller() and m == "GetAttribute" then
        local a = ...
        if infAmmo and a == "CurrentAmmo" then return 999 end
        if firerate and a == "IsAutomatic" then return true end
    end
    return oldNamecall(self, ...)
end))

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getDigTarget()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    rayParams.FilterDescendantsInstances = {char}
    local res = workspace:Raycast(mouse.UnitRay.Origin, mouse.UnitRay.Direction * 1000, rayParams)
    local pos = res and res.Position or mouse.Hit.Position
    local mat = res and res.Material or Enum.Material.Ground
    local diff = pos - root.Position
    return if diff.Magnitude > 9 then root.Position + diff.Unit * 8 else pos, mat
end

local function dig(mode)
    local pos, mat = getDigTarget()
    if pos and mat then Network:FireServer("PlayerWantsToDig", pos, mode, mat) end
end

KillTab:CreateToggle({Name = "Kill", CurrentValue = false, Flag = "KillToggle", Callback = function(v) kill = v end})
KillTab:CreateDropdown({Name = "Target Selector", Options = {"Bots", "Players", "Buildings"}, CurrentOption = {"Bots", "Players", "Buildings"}, MultipleOptions = true, Flag = "TargetDropdown", Callback = function(v) targets = v end})

PlayerTab:CreateToggle({Name = "Insta-Heal", CurrentValue = false, Flag = "InstaHealToggle", Callback = function(v) heal = v end})

WeaponTab:CreateToggle({Name = "FirerateBoost", CurrentValue = false, Flag = "FirerateToggle", Callback = function(v) firerate = v end})
WeaponTab:CreateSlider({Name = "Firerate Value", Range = {100, 10000}, Increment = 100, Suffix = "", CurrentValue = 6000, Flag = "FirerateSlider", Callback = function(v) firerateVal = v end})
WeaponTab:CreateToggle({Name = "NoSpread", CurrentValue = false, Flag = "NoSpreadToggle", Callback = function(v) noSpread = v end})
WeaponTab:CreateToggle({Name = "InfAmmo", CurrentValue = false, Flag = "InfAmmoToggle", Callback = function(v) infAmmo = v end})

MiscTab:CreateKeybind({Name = "Mouse Dig", CurrentKeybind = "T", HoldToInteract = true, Flag = "DigKeybind", Callback = function(v) if type(v) == "string" then digKey = v else digging = v end end})
MiscTab:CreateKeybind({Name = "Mouse Place", CurrentKeybind = "G", HoldToInteract = true, Flag = "PlaceKeybind", Callback = function(v) if type(v) == "string" then placeKey = v else placing = v end end})

uis.InputBegan:Connect(function(i, g)
    if g then return end
    if i.KeyCode.Name == digKey then digging = true elseif i.KeyCode.Name == placeKey then placing = true end
end)
uis.InputEnded:Connect(function(i)
    if i.KeyCode.Name == digKey then digging = false elseif i.KeyCode.Name == placeKey then placing = false end
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        if digging then pcall(dig, "Subtract") end
        if placing then pcall(dig, "Add") end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local myPos = root and root.Position or Vector3.new(0, 50, 0)
        local tool = char and char:FindFirstChildOfClass("Tool")
        local myTeam = lp.Team
        local myTeamName = myTeam and myTeam.Name
        local enemyTeam = myTeamName and ((myTeamName == "Black" and "Red") or (myTeamName == "Red" and "Black"))
        if kill and tool then
            pcall(function()
                local hasPlrs = table.find(targets, "Players") or targets["Players"]
                local hasBots = table.find(targets, "Bots") or targets["Bots"]
                local hasBuilds = table.find(targets, "Buildings") or targets["Buildings"]
                if hasPlrs then
                    for _, p in ipairs(plrs:GetPlayers()) do
                        if p ~= lp and p.Team ~= myTeam and p.Character then
                            local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")
                            if head and hum and hum.Health > 0 then
                                Network:FireServer("ClientHitCharacter", tool, myPos, head.Position, p.Character, head, "Bullet", (head.Position - myPos).Unit)
                            end
                        end
                    end
                end
                if hasBots then
                    local f = workspace:FindFirstChild("CharactersSpawned")
                    local npcs = f and f:FindFirstChild("Npcs")
                    if npcs then
                        for _, tf in ipairs(npcs:GetChildren()) do
                            if not enemyTeam or tf.Name == enemyTeam then
                                for _, m in ipairs(tf:GetChildren()) do
                                    if m:IsA("Model") then
                                        local head = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildOfClass("BasePart")
                                        local hum = m:FindFirstChildOfClass("Humanoid")
                                        if head and hum and hum.Health > 0 then
                                            Network:FireServer("ClientHitCharacter", tool, myPos, head.Position, m, head, "Bullet", (head.Position - myPos).Unit)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if hasBuilds then
                    local cf = workspace:FindFirstChild("Constructed Items Folder")
                    if cf then
                        for _, uf in ipairs(cf:GetChildren()) do
                            for _, item in ipairs(uf:GetChildren()) do
                                local tTeam = item:GetAttribute("Team")
                                if not myTeamName or not tTeam or tTeam ~= myTeamName then
                                    local hum = item:FindFirstChildOfClass("Humanoid")
                                    local hit = item:FindFirstChild("Head") or item:FindFirstChild("Hitbox") or item:FindFirstChild("HumanoidRootPart") or item:FindFirstChildOfClass("BasePart")
                                    if hum and hit and hum.Health > 0 then
                                        Network:FireServer("ClientHitCharacter", tool, myPos, hit.Position, item, hit, "Bullet", (hit.Position - myPos).Unit)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
        if heal and char then
            pcall(function()
                char:SetAttribute("HasMedicPassive", true)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    Network:FireServer("PassiveMedicHeal", hum)
                    if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
                end
                local bp = lp:FindFirstChild("Backpack")
                for _, c in ipairs({char, bp}) do
                    if c then
                        for _, t in ipairs(c:GetChildren()) do
                            if t:IsA("Tool") then
                                t:SetAttribute("DamageBlock", 99999)
                                t:SetAttribute("MaxDamageBlock", 99999)
                            end
                        end
                    end
                end
                Network:FireServer("RegenBlock", 99999)
            end)
        end
        pcall(function()
            local bp = lp:FindFirstChild("Backpack")
            for _, cont in ipairs({char, bp}) do
                if cont then
                    for _, t in ipairs(cont:GetChildren()) do
                        if t:IsA("Tool") then
                            local cfg = t:FindFirstChild("Config")
                            if cfg and cfg:IsA("ModuleScript") then
                                local c = require(cfg)
                                if noSpread then
                                    c.Spread, c.ShotgunSpread = 0, 0
                                    c.Recoil = {X = 0, Y = 0}
                                    if type(c.CrossHairStats) == "table" then
                                        c.CrossHairStats.MaxSpread, c.CrossHairStats.MinSpread, c.CrossHairStats.increasePerSecond = 0, 0, 0
                                    end
                                end
                                if firerate then c.FireRate, c.Cooldown, c.Automatic = firerateVal, 0, true end
                            end
                            if infAmmo then
                                local a = oldNamecall(t, "CurrentAmmo")
                                if a and a == 0 and not oldNamecall(t, "IsReloading") then
                                    Network:FireServer("RequestReload", t)
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)
