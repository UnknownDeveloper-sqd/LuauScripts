local Rayfield = loadstring(game:HttpGet("https://raw.githubusercontent.com/UnknownDeveloper-sqd/UnknownSquad-RayField-Lib/refs/heads/main/Rayfield/CustomRayfield.luau"))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function getController(name)
    for _, t in pairs(filtergc("table", { Keys = {"replicator", "name"} }, false)) do
        if t.name == name then
            return t
        end
    end
    return nil
end

local cubesTarget = getController("Cubes")

local State = {
    AutoTrain = false,
    AutoCube = false,
    EquipPriority = "Strength"
}

local trainThread = nil
local cubeThread = nil

local function safeRequire(instance)
    local req = (type(getrenv) == "function" and getrenv().require) or _G.require or require
    return req(instance)
end

local function ensureTrainEquipped()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Train" or item:GetAttribute("TrainTool") or item:GetAttribute("is_train_tool")) then
            return
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Train" or item:GetAttribute("TrainTool") or item:GetAttribute("is_train_tool")) then
                humanoid:EquipTool(item)
                return
            end
        end
    end
end

local function claimPopups()
    pcall(function()
        local pops = getController("Pops")
        if not pops then
            local popsModule = LocalPlayer:FindFirstChild("PlayerScripts")
                and LocalPlayer.PlayerScripts:FindFirstChild("Client")
                and LocalPlayer.PlayerScripts.Client:FindFirstChild("Controllers")
                and LocalPlayer.PlayerScripts.Client.Controllers:FindFirstChild("Pops")
            if popsModule then
                pops = safeRequire(popsModule)
            end
        end

        if pops and pops.live then
            for id, data in pairs(pops.live) do
                local is20X = false
                if data.gui then
                    local t = data.gui:FindFirstChild("Title", true)
                    if t and (t.Text:find("20X") or t.Text:find("20x") or t.Text:find("20")) then
                        is20X = true
                    end
                end
                if not (is20X or data.bought) then
                    pops:_Claim(id)
                end
            end
        end
    end)

    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if gui then
        for _, containerName in ipairs({"Screen", "Overlay"}) do
            local parent = gui:FindFirstChild(containerName)
            if parent then
                for _, obj in ipairs(parent:GetChildren()) do
                    if obj.Name == "POPUP" or (obj:IsA("GuiButton") and obj.Visible) then
                        local textLabel = obj:FindFirstChild("Title", true) or obj:FindFirstChildOfClass("TextLabel")
                        local txt = textLabel and textLabel.Text or ""
                        if (txt:find("X") or txt:find("x")) and not (txt:find("20X") or txt:find("20x") or txt:find("20")) then
                            if firesignal then
                                pcall(firesignal, obj.Activated)
                            elseif getconnections then
                                for _, conn in ipairs(getconnections(obj.Activated)) do
                                    conn:Fire()
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

local function getClosestCubePrompt()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = char.HumanoidRootPart.Position

    local cubesFolder = workspace:FindFirstChild("World") 
        and workspace.World:FindFirstChild("Shared") 
        and workspace.World.Shared:FindFirstChild("Cubes")

    if not cubesFolder then return nil end

    local closestPrompt, minDist = nil, math.huge
    for _, cube in ipairs(cubesFolder:GetChildren()) do
        local pos = cube:IsA("BasePart") and cube.Position or (cube:IsA("Model") and cube:GetPivot().Position) or Vector3.zero
        local dist = (rootPos - pos).Magnitude
        if dist < minDist then
            local prompt = cube:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled then
                minDist = dist
                closestPrompt = prompt
            end
        end
    end
    return closestPrompt
end

local function getClickFunction()
    local fns = filtergc("function", { Constants = {"NextClick"} }, false)
    for _, f in ipairs(fns) do
        if debug.info(f, "n") == "Click" then
            return f
        end
    end
    return nil
end

local function equipBetterCoaches(priority)
    local ctrl = getController("Coaches")
    if not ctrl or not ctrl.replicator then return end

    local meta = getmetatable(ctrl) and getmetatable(ctrl).__index
    local rep = ctrl.replicator

    local mod = nil
    pcall(function()
        local boostModule = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
            and game:GetService("ReplicatedStorage").Modules:FindFirstChild("CoachBoosts")
        if boostModule then
            mod = safeRequire(boostModule)
        end
    end)
    if not mod then return end

    local candidates = {}
    for _, c in ipairs(ctrl.owned or {}) do
        local uid = c.UID or c.uid
        local name = c.Name
        local stats = mod.Read({ name })
        table.insert(candidates, {
            uid = uid,
            name = name,
            strength = stats.Strength or 1,
            pushSpeed = stats.PushUp or 1,
            walkSpeed = stats.WalkSpeed or 1
        })
    end

    if priority == "Strength" then
        table.sort(candidates, function(a, b) return a.strength > b.strength end)
    elseif priority == "PushSpeed" then
        table.sort(candidates, function(a, b) return a.pushSpeed > b.pushSpeed end)
    elseif priority == "WalkSpeed" then
        table.sort(candidates, function(a, b) return a.walkSpeed > b.walkSpeed end)
    end

    local bestUids = {}
    local bestSet = {}
    for i = 1, math.min(3, #candidates) do
        table.insert(bestUids, candidates[i].uid)
        bestSet[candidates[i].uid] = true
    end

    local currentEquipped = ctrl.equipped or {}
    for _, uid in ipairs(currentEquipped) do
        if not bestSet[uid] then
            ctrl.selected = uid
            if meta and meta._Unequip then
                meta._Unequip(ctrl)
            else
                rep:Fire({ Function = "RequestUnequip", Args = { uid } })
            end
            task.wait(0.1)
        end
    end

    for _, uid in ipairs(bestUids) do
        local already = false
        for _, eq in ipairs(ctrl.equipped or {}) do
            if eq == uid then
                already = true
                break
            end
        end

        if not already and #(ctrl.equipped or {}) < 3 then
            ctrl.selected = uid
            if meta and meta._Equip then
                meta._Equip(ctrl)
            else
                rep:Fire({ Function = "RequestEquip", Args = { uid } })
            end
            task.wait(0.12)
        end
    end
end

local Window = Rayfield:CreateWindow({
    Name = "LaCube | Simple GUI",
    LoadingTitle = "LaCube | Simple GUI",
    LoadingSubtitle = "By: UnknownSquad",
    Theme = "Amethyst",
    Width = 460,
    Height = 360,
    Font = "Code",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)
local MiscTab = Window:CreateTab("Misc", 4483362458)

MainTab:CreateToggle({
    Name = "Auto-Train",
    CurrentValue = false,
    Flag = "AutoTrainFlag",
    Callback = function(Value)
        State.AutoTrain = Value
        if trainThread then
            pcall(task.cancel, trainThread)
            trainThread = nil
        end
        if Value then
            trainThread = task.spawn(function()
                while State.AutoTrain do
                    ensureTrainEquipped()
                    claimPopups()
                    task.wait(0.001)
                end
            end)
        end
    end
})

MainTab:CreateToggle({
    Name = "Auto-Cube",
    CurrentValue = false,
    Flag = "AutoCubeFlag",
    Callback = function(Value)
        State.AutoCube = Value
        if cubeThread then
            pcall(task.cancel, cubeThread)
            cubeThread = nil
        end
        if Value then
            cubeThread = task.spawn(function()
                while State.AutoCube do
                    if State.AutoTrain then
                        ensureTrainEquipped()
                    end
                    if not cubesTarget then
                        cubesTarget = getController("Cubes")
                    end

                    local prompt = getClosestCubePrompt()
                    if not prompt then
                        task.wait(0.001)
                        continue
                    end

                    if cubesTarget and not cubesTarget.active then
                        fireproximityprompt(prompt)
                    end

                    local t0 = tick()
                    while State.AutoCube and cubesTarget and not cubesTarget.active and tick() - t0 < 0.2 do
                        task.wait()
                    end

                    if State.AutoCube and cubesTarget and cubesTarget.active then
                        local clickFn = getClickFunction()
                        if clickFn then
                            while State.AutoCube and cubesTarget and cubesTarget.active do
                                cubesTarget.active.NextClick = 0
                                clickFn(cubesTarget)
                                task.wait()
                            end
                        end

                        if State.AutoTrain then
                            ensureTrainEquipped()
                        end
                    end
                    task.wait(0.001)
                end
            end)
        end
    end
})

MiscTab:CreateButton({
    Name = "Equip Better",
    Callback = function()
        equipBetterCoaches(State.EquipPriority)
    end
})

MiscTab:CreateDropdown({
    Name = "Priority",
    Options = {"Strength", "PushSpeed", "WalkSpeed"},
    CurrentOption = {"Strength"},
    MultipleOptions = false,
    Flag = "EquipPriorityFlag",
    Callback = function(Option)
        State.EquipPriority = type(Option) == "table" and Option[1] or Option
    end
})
