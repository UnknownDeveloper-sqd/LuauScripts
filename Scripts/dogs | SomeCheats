;end);h:SetStateEnabled(Enum.HumanoidStateType.Seated,true);if getgenv().OldPos then repeat r.CFrame=getgenv().OldPos*CFrame.new(0,.5,0);ch:SetPrimaryPartCFrame(r.CFrame);h:ChangeState("GettingUp");for _,v in pairs(ch:GetChildren())do if v:IsA("BasePart")then v.Velocity,v.RotVelocity=Vector3.zero,Vector3.zero;end;end;task.wait();until(r.Position-getgenv().OldPos.p).Magnitude<25 or not fAct;workspace.FallenPartsDestroyHeight=getgenv().FPDH or-500;end;end;task.spawn(function()while task.wait(0.08)do local ch=lp.Character;if ch then if aR then if ch:GetAttribute("Ragdolled")then ch:SetAttribute("Ragdolled",false);end;if ch:GetAttribute("Dragged")then ch:SetAttribute("Dragged",false);end;end;if nS and ch:GetAttribute("Slowed")then ch:SetAttribute("Slowed",nil);end;if iSt then pcall(function()ch:SetAttribute("Epicsauce",workspace:GetServerTimeNow()+10);end);end;end;end;end);local W=R:CreateWindow({Name="dogs | SomeCheats",LoadingTitle="dogs | SomeCheats",LoadingSubtitle="By: UnknownSquad",Theme="Amethyst",Width=460,Height=360,Font="Code",SSafe=true,ConfigurationSaving={Enabled=false},KeySystem=false});local M,Ms=W:CreateTab("Main","home"),W:CreateTab("Misc","wrench");M:CreateSection("Combat & Physics");M:CreateToggle({Name="Anti-Ragdoll",CurrentValue=false,Flag="AR",Callback=function(v)aR=v;end});M:CreateToggle({Name="NoSlowdown",CurrentValue=false,Flag="NS",Callback=function(v)nS=v;end});M:CreateSection("Target");local FD=M:CreateDropdown({Name="Select Player",Options=plrs(),CurrentOption={plrs()[1]or""},MultipleOptions=false,Flag="FD",Callback=function(s)tar=P:FindFirstChild(type(s)=="table"and s[1]or s);end});P.PlayerAdded:Connect(function()FD:Refresh(plrs());end);P.PlayerRemoving:Connect(function()FD:Refresh(plrs());end);M:CreateToggle({Name="Fling",CurrentValue=false,Flag="FT",Callback=function(v)fAct=v;if v then task.spawn(function()while fAct do if tar and tar.Parent then fling(tar);task.wait(0.1);else task.wait(0.5);end;end;end);else local ch=lp.Character;if ch then for _,v in pairs(ch:GetDescendants())do if v:IsA("BodyVelocity")or v:IsA("BodyAngularVelocity")then v:Destroy();end;end;end;end;end});Ms:CreateSection("Stats");Ms:CreateToggle({Name="InfStamina",CurrentValue=false,Flag="IS",Callback=function(v)iSt=v;end})
