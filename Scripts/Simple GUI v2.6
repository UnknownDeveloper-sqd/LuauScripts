PlayerTab:CreateSection("Player Dossier")

local InspectedPlayer = nil
local DossierAccountAge = PlayerTab:CreateLabel("Age: N/A")
local DossierHealth = PlayerTab:CreateLabel("Health: N/A")
local DossierTeam = PlayerTab:CreateLabel("Team: N/A")
local DossierDistance = PlayerTab:CreateLabel("Distance: N/A")

local function UpdateDossier()
	if not InspectedPlayer then
		return
	end
	pcall(function()
		DossierAccountAge:Set("Age: " .. InspectedPlayer.AccountAge .. " days")
		DossierTeam:Set("Team: " .. (InspectedPlayer.Team and InspectedPlayer.Team.Name or "None"))
		local char = InspectedPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hum then
				DossierHealth:Set("Health: " .. math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth))
			end
			if hrp and HumanoidRootPart then
				local dist = (hrp.Position - HumanoidRootPart.Position).Magnitude
				DossierDistance:Set(string.format("Distance: %.1f studs", dist))
			end
		else
			DossierHealth:Set("Health: Dead / None")
			DossierDistance:Set("Distance: N/A")
		end
	end)
end

