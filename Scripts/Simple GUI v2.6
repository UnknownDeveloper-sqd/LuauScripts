	local hui = (gethui and gethui()) or CoreGui
	ESPFolder.Parent = hui
end)

local function CacheCharacterParts(char)
	CharacterParts = {}
	if not char then
		return
	end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(CharacterParts, part)
		end
	end
end

local function UpdateCharacter()
	Character = LocalPlayer.Character
	if Character then
		Humanoid = Character:FindFirstChildOfClass("Humanoid")
		HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
		CacheCharacterParts(Character)
	else
		Humanoid = nil
		HumanoidRootPart = nil
		CharacterParts = {}
	end
end

UpdateCharacter()

LocalPlayer.CharacterAdded:Connect(function(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid", 5)
	HumanoidRootPart = char:WaitForChild("HumanoidRootPart", 5)
	CacheCharacterParts(char)
	
	if Humanoid then
		Humanoid.Died:Connect(function()
			if States.InstantRespawn then
				task.wait(0.1)
				LocalPlayer:LoadCharacter()
			end
		end)
	end
	
	task.wait(0.1)
	if States.WalkSpeedEnabled and Humanoid then
		Humanoid.WalkSpeed = Values.WalkSpeed
	end
	if States.JumpPowerEnabled and Humanoid then
		Humanoid.JumpPower = Values.JumpPower
		Humanoid.UseJumpPower = true
	end
end)

LocalPlayer.CharacterRemoving:Connect(function()
	Character = nil
	Humanoid = nil
	HumanoidRootPart = nil
	CharacterParts = {}
end)

local function GetTeamList()
	local list = {}
	for _, team in ipairs(Teams:GetTeams()) do
		table.insert(list, team.Name)
	end
	if #list == 0 then
		table.insert(list, "No Teams")
	end
	return list
end

local function StartNoclip()
	if NoclipConnection then
		return
	end
	NoclipConnection = RunService.Stepped:Connect(function()
		if not States.Noclip then
			return
		end
		for _, part in ipairs(CharacterParts) do
			if part and part.Parent then
				part.CanCollide = false
			end
		end
	end)
end

local function StopNoclip()
	if NoclipConnection then
		NoclipConnection:Disconnect()
		NoclipConnection = nil
	end
	for _, part in ipairs(CharacterParts) do
		if part and part.Parent then
			part.CanCollide = true
		end
	end
end

local function IsPlayerESPVisible(player)
	if player == LocalPlayer then
		return false
	end
	local teamName = player.Team and player.Team.Name or "None"
	if ESPSettings.WhiteListEnabled and not ESPSettings.WhiteListTeams[teamName] then
		return false
	end
	if ESPSettings.BlackListEnabled and ESPSettings.BlackListTeams[teamName] then
		return false
	end
	return true
end

local function CreateBoxESP(player)
	if not HasDrawing then
		return nil
	end
	local env = (getgenv and getgenv()) or _G
	local d = env.Drawing or Drawing
	local drawings = nil
	local ok = pcall(function()
		drawings = {
			TopLine     = d.new("Line"),
			BottomLine  = d.new("Line"),
			LeftLine    = d.new("Line"),
			RightLine   = d.new("Line"),
			HealthBarBg = d.new("Line"),
			HealthBarFg = d.new("Line")
		}
		for _, line in pairs(drawings) do
			line.Visible = false
			line.Color = ESPColors.BoxColor
			line.Thickness = 1.5
			line.Transparency = 1
		end
		drawings.HealthBarBg.Color = Color3.fromRGB(30, 30, 30)
		drawings.HealthBarBg.Thickness = 3
		drawings.HealthBarFg.Thickness = 2
	end)
	return ok and drawings or nil
end

local function HideAllLines(drawings)
	if not drawings then
		return
	end
	for _, line in pairs(drawings) do
		pcall(function()
			line.Visible = false
		end)
	end
end

local function UpdateBoxESPDrawings()
	if not HasDrawing then
		return
	end
	if not States.ESP or not States.BoxESP then
		for _, drawings in pairs(BoxESPDrawings) do
			HideAllLines(drawings)
		end
		return
	end

	for player, drawings in pairs(BoxESPDrawings) do
		if not drawings then
			continue
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		
		if not (char and hrp and hum and hum.Health > 0 and IsPlayerESPVisible(player)) then
			HideAllLines(drawings)
			continue
		end

		local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
		if not onScreen then
			HideAllLines(drawings)
			continue
		end

		local scale = 1000 / (Camera.CFrame.Position - hrp.Position).Magnitude
		local w = math.clamp(scale * 1.8, 10, 300)
		local h = math.clamp(scale * 2.8, 15, 450)
		local x = pos.X - w / 2
		local y = pos.Y - h / 2

		pcall(function()
			drawings.TopLine.From = Vector2.new(x, y)
			drawings.TopLine.To = Vector2.new(x + w, y)
			drawings.TopLine.Color = ESPColors.BoxColor
			drawings.TopLine.Visible = true

			drawings.BottomLine.From = Vector2.new(x, y + h)
			drawings.BottomLine.To = Vector2.new(x + w, y + h)
			drawings.BottomLine.Color = ESPColors.BoxColor
			drawings.BottomLine.Visible = true

			drawings.LeftLine.From = Vector2.new(x, y)
			drawings.LeftLine.To = Vector2.new(x, y + h)
			drawings.LeftLine.Color = ESPColors.BoxColor
			drawings.LeftLine.Visible = true

			drawings.RightLine.From = Vector2.new(x + w, y)
			drawings.RightLine.To = Vector2.new(x + w, y + h)
			drawings.RightLine.Color = ESPColors.BoxColor
			drawings.RightLine.Visible = true

			if States.HealthESP then
				local barX = x - 5
				local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
				local barHeight = h * healthPercent

				drawings.HealthBarBg.From = Vector2.new(barX, y)
				drawings.HealthBarBg.To = Vector2.new(barX, y + h)
				drawings.HealthBarBg.Visible = true

				drawings.HealthBarFg.From = Vector2.new(barX, y + h)
				drawings.HealthBarFg.To = Vector2.new(barX, y + h - barHeight)
				drawings.HealthBarFg.Color = ESPColors.HealthColor
				drawings.HealthBarFg.Visible = true
			else
				drawings.HealthBarBg.Visible = false
				drawings.HealthBarFg.Visible = false
			end
		end)
	end
end

local function CleanupBoxESP(player)
	if not HasDrawing then
		return
	end
	local drawings = BoxESPDrawings[player]
	if drawings then
		for _, line in pairs(drawings) do
			pcall(function()
				line:Remove()
			end)
		end
		BoxESPDrawings[player] = nil
	end
end

local function InitializeBoxESP()
	if not HasDrawing then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and not BoxESPDrawings[player] then
			BoxESPDrawings[player] = CreateBoxESP(player)
		end
	end
end

local function UpdateESP()
	ESPFolder:ClearAllChildren()
	
	if not States.ESP then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if not IsPlayerESPVisible(player) then
			continue
		end
		local char = player.Character
		if not char then
			continue
		end
		local head = char:FindFirstChild("Head")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not (head and hum and hum.Health > 0) then
			continue
		end

		if States.HighlightESP then
			local highlight = Instance.new("Highlight")
			highlight.Name = player.Name .. "_Highlight"
			highlight.Adornee = char
			highlight.FillColor = ESPColors.HighlightFillColor
			highlight.OutlineColor = ESPColors.HighlightOutlineColor
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.Parent = ESPFolder
		end

		if States.NameESP or States.HealthESP then
			local bbg = Instance.new("BillboardGui")
			bbg.Name = player.Name .. "_Billboard"
			bbg.Adornee = head
			bbg.Size = UDim2.new(0, 200, 0, 50)
			bbg.StudsOffset = Vector3.new(0, 2.5, 0)
			bbg.AlwaysOnTop = true

			local layout = Instance.new("UIListLayout")
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			layout.Parent = bbg

			if States.NameESP then
				local nameLabel = Instance.new("TextLabel")
				nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
				nameLabel.TextColor3 = ESPColors.NameColor
				nameLabel.TextSize = 14
				nameLabel.Font = Enum.Font.SourceSansBold
				nameLabel.BackgroundTransparency = 1
				nameLabel.Size = UDim2.new(1, 0, 0, 20)
				nameLabel.TextStrokeTransparency = 0.5
				nameLabel.LayoutOrder = 1
				nameLabel.Parent = bbg
			end

			if States.HealthESP and not States.BoxESP then
				local healthLabel = Instance.new("TextLabel")
				healthLabel.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
				healthLabel.TextColor3 = ESPColors.HealthColor
				healthLabel.TextSize = 12
				healthLabel.Font = Enum.Font.SourceSans
				healthLabel.BackgroundTransparency = 1
				healthLabel.Size = UDim2.new(1, 0, 0, 16)
				healthLabel.TextStrokeTransparency = 0.5
				healthLabel.LayoutOrder = 2
				healthLabel.Parent = bbg
			end

			bbg.Parent = ESPFolder
		end
	end
end

local function GetVehicle()
	if not Character then
		return nil
	end
	local hum = Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.SeatPart then
		local seat = hum.SeatPart
		return seat:FindFirstAncestorWhichIsA("Model") or seat
	end
	return nil
end

local function ApplyVehicleBoost(multiplier)
	local vehicle = GetVehicle()
	if not vehicle then
		return
	end
	for _, descendant in ipairs(vehicle:GetDescendants()) do
		if descendant:IsA("VehicleSeat") then
			descendant.MaxSpeed = 25 * multiplier
			descendant.Torque = 1 * multiplier
		end
	end
end

local function InstantRespawn()
	if not Character then
		return
	end
	local hrp = Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		OldPos = hrp.CFrame
	end
	local hum = Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Dead)
	end
	Character:ClearAllChildren()
	LocalPlayer:LoadCharacter()
	
	task.spawn(function()
		local newChar = LocalPlayer.CharacterAdded:Wait()
		local newHrp = newChar:WaitForChild("HumanoidRootPart", 5)
		if newHrp and OldPos then
			task.wait(0.2)
			newHrp.CFrame = OldPos
		end
	end)
end

local function FEInvisible()
	if not Character then
		return
	end
	local hrp = Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	
	local clone = Character:Clone()
	clone.Parent = Workspace
	Character:MoveTo(Vector3.new(0, 100000, 0))
	task.wait(0.1)
	
	for _, part in ipairs(Character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Transparency = 1
		end
	end
end

local function FlingTarget(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then
		return
	end
	local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not targetHrp or not HumanoidRootPart then
		return
	end
	
	local oldCFrame = HumanoidRootPart.CFrame
	local bV = Instance.new("BodyVelocity")
	bV.Velocity = Vector3.new(9e9, 9e9, 9e9)
	bV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bV.Parent = HumanoidRootPart
	
	local bAV = Instance.new("BodyAngularVelocity")
	bAV.AngularVelocity = Vector3.new(9e9, 9e9, 9e9)
	bAV.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bAV.Parent = HumanoidRootPart
	
	for _ = 1, 30 do
		if not targetHrp or not targetHrp.Parent then
			break
		end
		HumanoidRootPart.CFrame = targetHrp.CFrame
		task.wait(0.01)
	end
	
	bV:Destroy()
	bAV:Destroy()
	HumanoidRootPart.CFrame = oldCFrame
end

local function RunFlingAll()
	FlingActive = true
	task.spawn(function()
		while FlingActive do
			for _, target in pairs(FlingTargets) do
				if not FlingActive then
					break
				end
				if target and target.Parent and target.Character then
					FlingTarget(target)
					task.wait(0.1)
				end
			end
			task.wait(0.5)
		end
	end)
end

local function StopSpectating()
	if SpectatingPlayer then
		SpectatingPlayer = nil
		States.Spectating = false
		Camera.CameraSubject = OriginalCameraSubject or (Character and Character:FindFirstChildOfClass("Humanoid"))
	end
end

local function SpectatePlayer(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then
		return
	end
	local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		if not SpectatingPlayer then
			OriginalCameraSubject = Camera.CameraSubject
		end
		SpectatingPlayer = targetPlayer
		States.Spectating = true
		Camera.CameraSubject = hum
	end
end

local function StartFly()
	if not HumanoidRootPart then
		return
	end
	if FlyBodyGyro then
		FlyBodyGyro:Destroy()
	end
	if FlyBodyVelocity then
		FlyBodyVelocity:Destroy()
	end
	
	FlyBodyGyro = Instance.new("BodyGyro")
	FlyBodyGyro.P = 9e4
	FlyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	FlyBodyGyro.CFrame = HumanoidRootPart.CFrame
	FlyBodyGyro.Parent = HumanoidRootPart
	
	FlyBodyVelocity = Instance.new("BodyVelocity")
	FlyBodyVelocity.Velocity = Vector3.zero
	FlyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	FlyBodyVelocity.Parent = HumanoidRootPart
	
	if Humanoid then
		Humanoid.PlatformStand = true
	end
	
	FlyConnection = RunService.RenderStepped:Connect(function()
		if not States.Fly or not HumanoidRootPart or not FlyBodyVelocity or not FlyBodyGyro then
			return
		end
		local direction = Vector3.zero
		local camCF = Camera.CFrame
		
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction = direction + camCF.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction = direction - camCF.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction = direction - camCF.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction = direction + camCF.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction = direction + Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			direction = direction - Vector3.new(0, 1, 0)
		end
		
		FlyBodyVelocity.Velocity = (direction.Magnitude > 0) and (direction.Unit * Values.FlySpeed) or Vector3.zero
		FlyBodyGyro.CFrame = camCF
	end)
end

local function StopFly()
	if FlyConnection then
		FlyConnection:Disconnect()
		FlyConnection = nil
	end
	if FlyBodyGyro then
		FlyBodyGyro:Destroy()
		FlyBodyGyro = nil
	end
	if FlyBodyVelocity then
		FlyBodyVelocity:Destroy()
		FlyBodyVelocity = nil
	end
	if Humanoid then
		Humanoid.PlatformStand = false
	end
end

local function StartVehicleFly()
	local vehicle = GetVehicle()
	if not vehicle then
		States.VehicleFly = false
		return
	end
	local primaryPart = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
	if not primaryPart then
		return
	end
	
	if VehicleFlyBodyGyro then
		VehicleFlyBodyGyro:Destroy()
	end
	if VehicleFlyBodyVelocity then
		VehicleFlyBodyVelocity:Destroy()
	end
	
	VehicleFlyBodyGyro = Instance.new("BodyGyro")
	VehicleFlyBodyGyro.P = 9e4
	VehicleFlyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	VehicleFlyBodyGyro.CFrame = primaryPart.CFrame
	VehicleFlyBodyGyro.Parent = primaryPart
	
	VehicleFlyBodyVelocity = Instance.new("BodyVelocity")
	VehicleFlyBodyVelocity.Velocity = Vector3.zero
	VehicleFlyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	VehicleFlyBodyVelocity.Parent = primaryPart
	
	VehicleFlyConnection = RunService.RenderStepped:Connect(function()
		if not States.VehicleFly then
			return
		end
		local currentVehicle = GetVehicle()
		if not currentVehicle then
			States.VehicleFly = false
			return
		end
		local direction = Vector3.zero
		local camCF = Camera.CFrame
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction = direction + camCF.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction = direction - camCF.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction = direction - camCF.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction = direction + camCF.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction = direction + Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			direction = direction - Vector3.new(0, 1, 0)
		end
		
		if VehicleFlyBodyVelocity and VehicleFlyBodyVelocity.Parent then
			VehicleFlyBodyVelocity.Velocity = (direction.Magnitude > 0) and (direction.Unit * Values.VehicleFlySpeed) or Vector3.zero
		end
		if VehicleFlyBodyGyro and VehicleFlyBodyGyro.Parent then
			VehicleFlyBodyGyro.CFrame = camCF
		end
	end)
end

local function StopVehicleFly()
	if VehicleFlyConnection then
		VehicleFlyConnection:Disconnect()
		VehicleFlyConnection = nil
	end
	if VehicleFlyBodyGyro then
		VehicleFlyBodyGyro:Destroy()
		VehicleFlyBodyGyro = nil
	end
	if VehicleFlyBodyVelocity then
		VehicleFlyBodyVelocity:Destroy()
		VehicleFlyBodyVelocity = nil
	end
end

