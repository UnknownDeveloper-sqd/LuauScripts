ServerTab:CreateButton({
	Name = "Rejoin Server",
	Callback = function()
		if #Players:GetPlayers() <= 1 then
			LocalPlayer:Kick("\nRejoining...")
			task.wait()
			TeleportService:Teleport(game.PlaceId, LocalPlayer)
		else
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
		end
	end
})

ServerTab:CreateButton({
	Name = "Server Hop",
	Callback = function()
		pcall(function()
			local serversApi = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
			local raw = game:HttpGet(serversApi)
			local body = HttpService:JSONDecode(raw)
			if body and body.data then
				for _, server in ipairs(body.data) do
					if type(server) == "table" and server.id ~= game.JobId and server.playing < server.maxPlayers then
						TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
						break
					end
				end
			end
		end)
	end
})

