local HasDrawing = false
pcall(function()
	local env = (getgenv and getgenv()) or _G
	local d = env.Drawing or Drawing
	if d and d.new then
		local test = d.new("Line")
		if test then
			test:Remove()
			HasDrawing = true
		end
	end
end)

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESPFolder"
