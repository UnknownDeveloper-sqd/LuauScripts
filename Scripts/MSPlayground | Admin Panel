local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local Rayfield = loadstring(game:HttpGet("https://raw.githubusercontent.com/UnknownDeveloper-sqd/UnknownSquad-RayField-Lib/refs/heads/main/Rayfield/CustomRayfield.luau"))()
loadstring(game:HttpGet("https://gist.github.com/UnknownDeveloper-sqd/8aad07fe6d7156bdc3bafac33b306235/raw/af219f1e686b5409a54230607737e27c09a53216/Script"))()

local Window = Rayfield:CreateWindow({
    Name = "MSPlayground | Admin Panel",
    LoadingTitle = "MSPlayground | Admin Panel",
    LoadingSubtitle = "By: UnknownSquad",
    Theme = "Amethyst",
    Width = 460,
    Height = 360,
    Font = "Code",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local mouseDeletorActive = false
local serverNotificationText = "Server Announcement"

local function getF3XEndpoint()
    local btools = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Building Tools"))
        or (LocalPlayer:FindFirstChildOfClass("Backpack") and LocalPlayer.Backpack:FindFirstChild("Building Tools"))
        or game:GetService("StarterPack"):FindFirstChild("Building Tools")
    
    local ep = btools and btools:FindFirstChild("SyncAPI") and btools.SyncAPI:FindFirstChild("ServerEndpoint")
    if not ep then
        ep = workspace:FindFirstChild("ServerEndpoint", true) or ReplicatedStorage:FindFirstChild("ServerEndpoint", true)
    end
    return ep
end

local function dropClipboard()
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not playerGui then return end

        local dropEvent = playerGui:FindFirstChild("DropEvent", true)
        if dropEvent and dropEvent:IsA("RemoteEvent") then
            dropEvent:FireServer()
        end

        local dropBtn = playerGui:FindFirstChild("Overlay")
            and playerGui.Overlay:FindFirstChild("Clipboard")
            and playerGui.Overlay.Clipboard:FindFirstChild("Drop")

        if dropBtn and type(getconnections) == "function" then
            for _, conn in ipairs(getconnections(dropBtn.MouseButton1Click)) do
                if conn.Function then
                    pcall(conn.Function)
                end
            end
        end

        local clipboardScript = playerGui:FindFirstChild("ClipboardScript", true)
        if clipboardScript and clipboardScript:FindFirstChild("Obtained") then
            clipboardScript.Obtained.Value = false
        end
    end)
end

local selectionBox = Instance.new("SelectionBox")
selectionBox.Name = "MouseDeletorBox"
selectionBox.Color3 = Color3.fromRGB(0, 150, 255)
selectionBox.LineThickness = 0.05
selectionBox.SurfaceColor3 = Color3.fromRGB(0, 150, 255)
selectionBox.SurfaceTransparency = 0.8
selectionBox.Parent = game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

local renderConn = nil
local clickConn = nil

local function updateMouseDeletorState(enabled)
    mouseDeletorActive = enabled
    if enabled then
        renderConn = RunService.RenderStepped:Connect(function()
            if mouseDeletorActive and Mouse.Target and Mouse.Target:IsA("BasePart") then
                selectionBox.Adornee = Mouse.Target
            else
                selectionBox.Adornee = nil
            end
        end)
        
        clickConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 and mouseDeletorActive then
                local target = Mouse.Target
                if target and target:IsA("BasePart") then
                    local serverEndpoint = getF3XEndpoint()
                    if serverEndpoint then
                        pcall(function()
                            serverEndpoint:InvokeServer("Remove", { target })
                        end)
                    end
                end
            end
        end)
    else
        if renderConn then
            renderConn:Disconnect()
            renderConn = nil
        end
        if clickConn then
            clickConn:Disconnect()
            clickConn = nil
        end
        selectionBox.Adornee = nil
    end
end

local MainTab = Window:CreateTab("Main", 4483362458)
local MapTab = Window:CreateTab("Map", 4483362458)
local ServerTab = Window:CreateTab("Server", 4483362458)

MainTab:CreateSection("Character & Items")

MainTab:CreateButton({
    Name = "Drop Clipboard",
    Callback = function()
        dropClipboard()
    end
})

MainTab:CreateButton({
    Name = "Get ALL Badges",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            local badgeParts = {}
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    if v.Name:lower():find("badge") 
                       or (v.Parent and v.Parent.Name:lower():find("badge"))
                       or (v.Parent and v.Parent.Parent and v.Parent.Parent.Name:lower():find("badge")) then
                        table.insert(badgeParts, v)
                    end
                end
            end

            for _, part in ipairs(badgeParts) do
                task.spawn(function()
                    pcall(function()
                        if firetouchinterest then
                            firetouchinterest(root, part, 0)
                            firetouchinterest(root, part, 1)
                        else
                            root.CFrame = part.CFrame
                        end
                    end)
                end)
            end
        end)
    end
})

MainTab:CreateSection("Prop Cleaner")

MainTab:CreateButton({
    Name = "Remove ALL Props",
    Callback = function()
        local serverEndpoint = getF3XEndpoint()
        local protected = {
            ["Lobby"] = true,
            ["MAPS"] = true,
            ["Terrain"] = true,
            ["Camera"] = true,
            ["Baseplate"] = true
        }

        local targets = {}
        for _, child in ipairs(workspace:GetChildren()) do
            if not protected[child.Name] and not Players:GetPlayerFromCharacter(child) then
                if child:IsA("BasePart") or child:IsA("Model") then
                    table.insert(targets, child)
                end
                for _, desc in ipairs(child:GetDescendants()) do
                    if desc:IsA("BasePart") or desc:IsA("Model") then
                        table.insert(targets, desc)
                    end
                end
            end
        end

        if #targets > 0 and serverEndpoint then
            task.spawn(function()
                pcall(function()
                    serverEndpoint:InvokeServer("Remove", targets)
                end)
            end)
        end
    end
})

MapTab:CreateSection("Target Deletion")

MapTab:CreateToggle({
    Name = "Mouse Deletor",
    CurrentValue = false,
    Flag = "MouseDeletorToggle",
    Callback = function(Value)
        updateMouseDeletorState(Value)
    end
})

MapTab:CreateSection("Zone Purge")

MapTab:CreateButton({
    Name = "Delete MAPS Folder",
    Callback = function()
        local mapsFolder = workspace:FindFirstChild("MAPS") or workspace:FindFirstChild("Maps")
        if mapsFolder then
            local serverEndpoint = getF3XEndpoint()
            if serverEndpoint then
                local targets = {}
                for _, desc in ipairs(mapsFolder:GetDescendants()) do
                    if desc:IsA("BasePart") or desc:IsA("Model") then
                        table.insert(targets, desc)
                    end
                end
                if #targets > 0 then
                    task.spawn(function()
                        pcall(function()
                            serverEndpoint:InvokeServer("Remove", targets)
                        end)
                    end)
                end
            end
        end
    end
})

MapTab:CreateButton({
    Name = "Delete Lobby Folder",
    Callback = function()
        local lobbyFolder = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("LOBBY")
        if lobbyFolder then
            local serverEndpoint = getF3XEndpoint()
            if serverEndpoint then
                local targets = {}
                for _, desc in ipairs(lobbyFolder:GetDescendants()) do
                    if desc:IsA("BasePart") or desc:IsA("Model") then
                        table.insert(targets, desc)
                    end
                end
                if #targets > 0 then
                    task.spawn(function()
                        pcall(function()
                            serverEndpoint:InvokeServer("Remove", targets)
                        end)
                    end)
                end
            end
        end
    end
})

ServerTab:CreateSection("Announcements")

ServerTab:CreateInput({
    Name = "Notification Text",
    PlaceholderText = "Type notification text here",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        if Text and Text ~= "" then
            serverNotificationText = Text
        end
    end
})

ServerTab:CreateButton({
    Name = "Send Server Notification",
    Callback = function()
        local notifClient = ReplicatedStorage:FindFirstChild("NotificationClient", true)
        if notifClient then
            if notifClient:IsA("RemoteEvent") then
                pcall(function() notifClient:FireServer(serverNotificationText, 10) end)
            elseif notifClient:IsA("BindableEvent") then
                pcall(function() notifClient:Fire(serverNotificationText, 10) end)
            end
        end
    end
})

local imageLoaderOk, imageLoaderError = pcall(function()
    local HttpService = game:GetService("HttpService")
    local IMAGE_API = "https://imagetojson-ap1.netlify.app/api/image"

    local imageLink = ""
    local imageSize = 512
    local pixelScale = 0.05
    local baseSpeed = 100
    local pixelsPerSecond = baseSpeed * 5
    local imageBusy = false
    local cancelDraw = false
    local drawnParts = {}
    local lastError = ""

    local ImageTab = Window:CreateTab("Image Loader", 4483362458)

    local function notify(text)
        pcall(function()
            Rayfield:Notify({Title = "Image Loader", Content = tostring(text), Duration = 5})
        end)
    end

    local function fetchImage(link, size)
        local base = IMAGE_API .. "?size=" .. size .. "&maxrun=64&url=" .. HttpService:UrlEncode(link)
        local width, height
        local runs = {}
        local from = 0

        repeat
            local data = HttpService:JSONDecode(game:HttpGet(base .. "&from=" .. from))
            if data.error then
                error(data.error)
            end
            width, height = data.width, data.height
            for _, r in ipairs(data.runs) do
                local cx = r[1] + r[3] / 2
                local cy = r[2] + 0.5
                local dx = math.min(cx, width - cx)
                local dy = math.min(cy, height - cy)
                table.insert(runs, {
                    x = r[1],
                    y = r[2],
                    len = r[3],
                    color = Color3.fromRGB(r[4], r[5], r[6]),
                    dist = dx * dx + dy * dy
                })
            end
            from = data.next
        until from >= height or cancelDraw

        table.sort(runs, function(a, b)
            return a.dist < b.dist
        end)

        return {width = width, height = height, runs = runs}
    end

    local function drawImage(data)
        local ep = getF3XEndpoint()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not ep then
            notify("F3X endpoint not found")
            return
        end
        if not root then return end

        local w, h = data.width, data.height
        local runs = data.runs
        local origin = root.CFrame * CFrame.new(0, h * pixelScale / 2 - 2, -12)
        local interval = 0.1
        local chunk = pixelsPerSecond * interval
        local maxInflight = math.huge
        local inflight = 0
        local failed = 0
        local i = 1

        local function processChunk(batch)
            local resize, color, anchor = {}, {}, {}
            local pending = #batch

            for _, r in ipairs(batch) do
                task.spawn(function()
                    local cf = origin * CFrame.new((r.x + r.len / 2 - w / 2) * pixelScale, (h / 2 - r.y - 0.5) * pixelScale, 0)
                    local ok, part = pcall(function()
                        return ep:InvokeServer("CreatePart", "Normal", cf, workspace)
                    end)
                    if ok and part then
                        table.insert(drawnParts, part)
                        table.insert(resize, {Part = part, CFrame = cf, Size = Vector3.new(r.len * pixelScale, pixelScale, 0.05)})
                        table.insert(color, {Part = part, Color = r.color, UnionColoring = false})
                        table.insert(anchor, {Part = part, Anchored = true})
                    else
                        failed = failed + 1
                        lastError = ok and "CreatePart returned nothing" or tostring(part)
                    end
                    pending = pending - 1
                end)
            end

            while pending > 0 do
                task.wait()
            end

            if #resize > 0 then
                pcall(function() ep:InvokeServer("SyncResize", resize) end)
                pcall(function() ep:InvokeServer("SyncColor", color) end)
                pcall(function() ep:InvokeServer("SyncAnchor", anchor) end)
            end

            inflight = inflight - 1
        end

        while i <= #runs and not cancelDraw do
            local started = os.clock()
            local batch = {}
            local budget = 0

            while i <= #runs and budget < chunk do
                local r = runs[i]
                i = i + 1
                budget = budget + r.len
                table.insert(batch, r)
            end

            inflight = inflight + 1
            task.spawn(processChunk, batch)

            if #drawnParts == 0 and failed >= 20 then
                cancelDraw = true
                notify("Parts are not being created: " .. lastError)
                warn(lastError)
            end

            while inflight >= maxInflight and not cancelDraw do
                task.wait()
            end

            task.wait(math.max(0, interval - (os.clock() - started)))
        end

        while inflight > 0 do
            task.wait(0.1)
        end
    end

    local function clearImage()
        cancelDraw = true
        task.spawn(function()
            while imageBusy do
                task.wait(0.1)
            end
            cancelDraw = false

            local ep = getF3XEndpoint()
            if not ep then return end

            local list = drawnParts
            drawnParts = {}

            for i = 1, #list, 200 do
                local batch = {}
                for j = i, math.min(i + 199, #list) do
                    if list[j] and list[j].Parent then
                        table.insert(batch, list[j])
                    end
                end
                if #batch > 0 then
                    pcall(function() ep:InvokeServer("Remove", batch) end)
                end
                task.wait()
            end
        end)
    end

    ImageTab:CreateSection("Image")

    local urlInput = ImageTab:CreateInput({
        Name = "Image URL",
        PlaceholderText = "https://...",
        RemoveTextAfterFocusLost = false,
        Callback = function(Text)
            imageLink = Text
        end
    })

    ImageTab:CreateInput({
        Name = "Size (0 = original)",
        PlaceholderText = "512",
        RemoveTextAfterFocusLost = false,
        Callback = function(Text)
            imageSize = math.max(math.floor(tonumber(Text) or 512), 0)
        end
    })

    ImageTab:CreateInput({
        Name = "Pixel Scale",
        PlaceholderText = "0.05",
        RemoveTextAfterFocusLost = false,
        Callback = function(Text)
            pixelScale = math.max(tonumber(Text) or 0.05, 0.05)
        end
    })

    local speedOptions = {}
    for n = 1, 50 do
        table.insert(speedOptions, n .. "x")
    end

    ImageTab:CreateDropdown({
        Name = "Speed",
        Options = speedOptions,
        CurrentOption = {"5x"},
        MultipleOptions = false,
        Callback = function(Option)
            local value = type(Option) == "table" and Option[1] or Option
            local multiplier = tonumber(tostring(value):match("%d+")) or 5
            pixelsPerSecond = baseSpeed * multiplier
        end
    })

    ImageTab:CreateButton({
        Name = "Load Image",
        Callback = function()
            if imageBusy then
                notify("Busy, press Clear Image to stop")
                return
            end
            if imageLink == "" and urlInput and urlInput.value then
                imageLink = tostring(urlInput.value)
            end
            if imageLink == "" then
                notify("Enter image URL")
                return
            end
            imageBusy = true
            cancelDraw = false
            task.spawn(function()
                local ok, err = pcall(function()
                    notify("Fetching image")
                    local okFetch, data = pcall(fetchImage, imageLink, imageSize)
                    if not okFetch then
                        if tostring(data):find("Unsupported MIME") then
                            data = fetchImage("https://images.weserv.nl/?output=png&url=" .. HttpService:UrlEncode(imageLink), imageSize)
                        else
                            error(data)
                        end
                    end
                    notify("Fetched " .. #data.runs .. " blocks, drawing")
                    if not cancelDraw then
                        drawImage(data)
                    end
                    notify("Done: " .. #drawnParts .. " parts")
                end)
                if not ok then
                    warn(err)
                    notify(err)
                end
                imageBusy = false
            end)
        end
    })

    ImageTab:CreateButton({
        Name = "Clear Image",
        Callback = function()
            clearImage()
        end
    })
end)

if not imageLoaderOk then
    warn(imageLoaderError)
    pcall(function()
        Rayfield:Notify({Title = "Image Loader", Content = tostring(imageLoaderError), Duration = 10})
    end)
end
