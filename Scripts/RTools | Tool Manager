UseTab:CreateButton({
    Name = "Use Tool",
    Callback = function()
        if not selectedUseTool or selectedUseTool == "" or selectedUseTool == "No matching tools" or selectedUseTool == "No tools in inventory" then
            return
        end

        local targetP = Players:FindFirstChild(selectedUsePlayer) or LocalPlayer
        local baseName = string.gsub(selectedUseTool, " #%d+$", "")

        local toolObj = currentUseToolObjects[selectedUseTool]
        if not toolObj or not toolObj.Parent then
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
            local char = LocalPlayer.Character
            toolObj = (bp and bp:FindFirstChild(baseName)) or (char and char:FindFirstChild(baseName))
        end

        if not toolObj or not toolObj.Parent then
            GiveTool:FireServer(LocalPlayer.Name, baseName)
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
            toolObj = bp and bp:WaitForChild(baseName, 1)
        end

        if toolObj and toolObj.Parent then
            activateToolInstance(toolObj, targetP)
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(500, 500))
            end)
        end
    end
})

UseTab:CreateButton({
    Name = "Use All",
    Callback = function()
        local targetP = Players:FindFirstChild(selectedUsePlayer) or LocalPlayer
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character

        local toolsToUse = {}
        if bp then
            for _, item in ipairs(bp:GetChildren()) do
                if item:IsA("Tool") then
                    table.insert(toolsToUse, item)
                end
            end
        end
        if char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Tool") then
                    table.insert(toolsToUse, item)
                end
            end
        end

        task.spawn(function()
            for _, toolObj in ipairs(toolsToUse) do
                if toolObj and toolObj.Parent then
                    toolObj.Parent = char
                end
            end

            for _, toolObj in ipairs(toolsToUse) do
                if toolObj and toolObj.Parent then
                    activateToolInstance(toolObj, targetP)
                end
            end

            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(500, 500))
            end)
        end)
    end
})

local SpamTab = Window:CreateTab("SpamTool", 4483362458)
SpamTab:CreateSection("Tools")

local SpamToolDropdown

local function filterSpamTools(query)
    query = string.lower(query or "")
    filteredSpamTools = {}
    if query == "" then
        for _, name in ipairs(allToolNames) do
            table.insert(filteredSpamTools, name)
        end
    else
        for _, name in ipairs(allToolNames) do
            if string.find(string.lower(name), query, 1, true) then
                table.insert(filteredSpamTools, name)
            end
        end
    end

    if #filteredSpamTools == 0 then
        table.insert(filteredSpamTools, "No matching tools")
    end

    if SpamToolDropdown then
        if SpamToolDropdown.Refresh then
            SpamToolDropdown:Refresh(filteredSpamTools, false)
        end
        if SpamToolDropdown.Set and filteredSpamTools[1] then
            pcall(function()
                SpamToolDropdown:Set({ filteredSpamTools[1] })
            end)
            selectedSpamTool = filteredSpamTools[1]
        end
    end
end

SpamTab:CreateInput({
    Name = "Search Tool",
    PlaceholderText = "Type tool name to filter...",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        filterSpamTools(Text)
    end
})

SpamToolDropdown = SpamTab:CreateDropdown({
    Name = "Select Tool",
    Options = filteredSpamTools,
    CurrentOption = { selectedSpamTool },
    Flag = "SpamSelectedTool",
    Callback = function(Option)
        local val = parseOptionValue(Option)
        if val ~= "" and val ~= "No matching tools" then
            selectedSpamTool = val
        end
    end
})

SpamTab:CreateSlider({
    Name = "Amount",
    Range = {1, 100},
    Increment = 1,
    CurrentValue = spamCount,
    Flag = "SpamToolAmount",
    Callback = function(Value)
        spamCount = math.clamp(tonumber(Value) or 10, 1, 100)
    end
})

SpamTab:CreateSection("Action")

SpamTab:CreateButton({
    Name = "Execute",
    Callback = function()
        if selectedSpamTool == "" or selectedSpamTool == "No matching tools" then
            return
        end

        local targetName = selectedSpamTool

        task.spawn(function()
            for i = 1, spamCount do
                task.spawn(function()
                    GiveTool:FireServer(LocalPlayer.Name, targetName)
                end)
            end

            local spawned = {}
            local deadline = tick() + 2.5
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
            local char = LocalPlayer.Character

            while tick() < deadline and #spawned < spamCount do
                for _, loc in ipairs({ bp, char }) do
                    if loc then
                        for _, item in ipairs(loc:GetChildren()) do
                            if item:IsA("Tool") and item.Name == targetName and not item:GetAttribute("IsSpamTool") then
                                item:SetAttribute("IsSpamTool", true)
                                table.insert(spawned, item)
                            end
                        end
                    end
                end
                task.wait(0.02)
            end

            for _, toolObj in ipairs(spawned) do
                if toolObj and toolObj.Parent then
                    toolObj.Parent = char
                end
            end

            for _, toolObj in ipairs(spawned) do
                if toolObj and toolObj.Parent then
                    pcall(function() toolObj:Activate() end)
                    if firesignal then pcall(firesignal, toolObj.Activated) end
                    if getconnections then
                        for _, c in ipairs(getconnections(toolObj.Activated)) do
                            pcall(function() c:Fire() end)
                        end
                    end
                    for _, c in ipairs(toolObj:GetChildren()) do
                        if c:IsA("RemoteEvent") then pcall(function() c:FireServer() end) end
                    end
                end
            end

            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(500, 500))
            end)

            task.wait(0.15)

            for _, toolObj in ipairs(spawned) do
                if toolObj and toolObj.Parent then
                    pcall(function()
                        toolObj.Parent = workspace
                        toolObj:Destroy()
                    end)
                end
            end

            for _, loc in ipairs({ bp, char }) do
                if loc then
                    for _, item in ipairs(loc:GetChildren()) do
                        if item:IsA("Tool") and item:GetAttribute("IsSpamTool") then
                            pcall(function()
                                item.Parent = workspace
                                item:Destroy()
                            end)
                        end
                    end
                end
            end
        end)
    end
})

local TrollTab = Window:CreateTab("TrollTool", 4483362458)
TrollTab:CreateSection("Target Players")

local selectedTrollPlayers = {}
local function getTrollPlayerOptions()
    local opts = { "All Players" }
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(opts, p.Name)
        end
    end
    return opts
end

local TrollPlayerDropdown = TrollTab:CreateDropdown({
    Name = "Select Target Players",
    Options = getTrollPlayerOptions(),
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "TrollTargetPlayers",
    Callback = function(Options)
        table.clear(selectedTrollPlayers)
        local opts = type(Options) == "table" and Options or { Options }
        for _, opt in ipairs(opts) do
            selectedTrollPlayers[opt] = true
        end
    end
})

local function getSelectedTargets()
    local targets = {}
    if selectedTrollPlayers["All Players"] then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                table.insert(targets, p)
            end
        end
    else
        for name, selected in pairs(selectedTrollPlayers) do
            if selected and name ~= "All Players" then
                local p = Players:FindFirstChild(name)
                if p and p.Character then
                    table.insert(targets, p)
                end
            end
        end
    end
    return targets
end

local function getTrollTool(name)
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name) or LocalPlayer.Backpack:FindFirstChild(name)
    if not tool then
        GiveTool:FireServer(LocalPlayer.Name, name)
        tool = LocalPlayer.Backpack:WaitForChild(name, 2)
    end
    return tool
end

TrollTab:CreateSection("Actions")

TrollTab:CreateButton({
    Name = "Cleave",
    Callback = function()
        local targets = getSelectedTargets()
        for _, target in ipairs(targets) do
            task.spawn(function()
                if not target.Character then return end
                local part = target.Character:FindFirstChild("Torso") 
                    or target.Character:FindFirstChild("UpperTorso") 
                    or target.Character:FindFirstChild("HumanoidRootPart") 
                    or target.Character:FindFirstChild("LowerTorso")
                if not part then return end

                GiveTool:FireServer(LocalPlayer.Name, "Cleave")
                local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
                local tool = bp and bp:WaitForChild("Cleave", 1.5)
                if not tool then
                    tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Cleave")
                end

                if tool then
                    local remote = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChildWhichIsA("RemoteEvent", true)
                    if remote then
                        tool.Parent = LocalPlayer.Character
                        remote:FireServer(part)
                    end
                    task.wait(0.1)
                    pcall(function()
                        tool.Parent = workspace
                        tool:Destroy()
                    end)
                end
            end)
            task.wait(0.05)
        end

        task.wait(0.3)
        pcall(function()
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, item in ipairs(bp:GetChildren()) do
                    if item:IsA("Tool") and item.Name == "Cleave" then
                        item.Parent = workspace
                        item:Destroy()
                    end
                end
            end
            if LocalPlayer.Character then
                for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
                    if item:IsA("Tool") and item.Name == "Cleave" then
                        item.Parent = workspace
                        item:Destroy()
                    end
                end
            end
        end)
    end
})

TrollTab:CreateButton({
    Name = "Meteor",
    Callback = function()
        local tool = getTrollTool("meteor")
        if not tool then return end

        local remote = tool:FindFirstChild("Activated") or tool:FindFirstChildWhichIsA("RemoteEvent", true)
        if remote then
            for _, target in ipairs(getSelectedTargets()) do
                if target.Character then
                    local root = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Torso") or target.Character:FindFirstChild("UpperTorso")
                    if root then
                        remote:FireServer(root.CFrame)
                    end
                end
            end
        end
        task.wait(0.05)
        pcall(function()
            tool.Parent = workspace
            tool:Destroy()
        end)
    end
})

TrollTab:CreateButton({
    Name = "Kill",
    Callback = function()
        local tool = getTrollTool("Cat gun")
        if not tool then return end

        local inflict = tool:FindFirstChild("GunScript_Server") and tool.GunScript_Server:FindFirstChild("InflictTarget")
        if inflict then
            for _, target in ipairs(getSelectedTargets()) do
                if target.Character then
                    local hum = target.Character:FindFirstChildOfClass("Humanoid")
                    local torso = target.Character:FindFirstChild("Torso") or target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("HumanoidRootPart")
                    if hum and torso then
                        inflict:FireServer(hum, torso, 999999, Vector3.zero, 0, 0, false)
                    end
                end
            end
        end
        task.wait(0.05)
        pcall(function()
            tool.Parent = workspace
            tool:Destroy()
        end)
    end
})

local BlackListTab = Window:CreateTab("BlackListTool", 4483362458)
BlackListTab:CreateSection("Blacklist")

BlackListTab:CreateToggle({
    Name = "Blacklist",
    CurrentValue = false,
    Flag = "BlacklistToggle",
    Callback = function(Value)
        blacklistEnabled = Value
    end
})

BlackListTab:CreateSection("Tools")

local function buildBlacklistToolOptions()
    local opts = { "[ALL TOOLS]" }
    for _, name in ipairs(allToolNames) do
        table.insert(opts, name)
    end
    return opts
end

local BlacklistToolDropdown

local function filterBlacklistTools(query)
    query = string.lower(query or "")
    filteredBlacklistTools = {}
    table.insert(filteredBlacklistTools, "[ALL TOOLS]")

    if query == "" then
        for _, name in ipairs(allToolNames) do
            table.insert(filteredBlacklistTools, name)
        end
    else
        for _, name in ipairs(allToolNames) do
            if string.find(string.lower(name), query, 1, true) then
                table.insert(filteredBlacklistTools, name)
            end
        end
    end

    if BlacklistToolDropdown and BlacklistToolDropdown.Refresh then
        BlacklistToolDropdown:Refresh(filteredBlacklistTools, false)
    end
end

BlackListTab:CreateInput({
    Name = "Search Tools",
    PlaceholderText = "Type tool name to filter...",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        filterBlacklistTools(Text)
    end
})

BlacklistToolDropdown = BlackListTab:CreateDropdown({
    Name = "Select Tools",
    Options = buildBlacklistToolOptions(),
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "BlacklistToolsMulti",
    Callback = function(Options)
        table.clear(blacklistSelectedTools)
        local opts = type(Options) == "table" and Options or { Options }
        for _, opt in ipairs(opts) do
            blacklistSelectedTools[opt] = true
        end
    end
})

BlackListTab:CreateSection("WhiteList")

local BlacklistWhiteListDropdown = BlackListTab:CreateDropdown({
    Name = "WhiteList Players",
    Options = playerNames,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "BlacklistWhiteListMulti",
    Callback = function(Options)
        table.clear(blacklistWhiteListPlayers)
        local opts = type(Options) == "table" and Options or { Options }
        for _, opt in ipairs(opts) do
            blacklistWhiteListPlayers[opt] = true
        end
    end
})

task.spawn(function()
    while true do
        if blacklistEnabled then
            local isAll = blacklistSelectedTools["[ALL TOOLS]"]
            local hasAnySpecific = false
            for k, v in pairs(blacklistSelectedTools) do
                if v and k ~= "[ALL TOOLS]" then
                    hasAnySpecific = true
                    break
                end
            end

            for _, player in ipairs(Players:GetPlayers()) do
                if not blacklistWhiteListPlayers[player.Name] then
                    if isAll then
                        ClearTools:FireServer(player.Name)
                    end

                    local containers = {}
                    if player == LocalPlayer then
                        local bp = player:FindFirstChildOfClass("Backpack") or player:FindFirstChild("Backpack")
                        if bp then table.insert(containers, bp) end
                    end
                    if player.Character then
                        table.insert(containers, player.Character)
                    end

                    local shouldClearServer = false

                    for _, container in ipairs(containers) do
                        for _, item in ipairs(container:GetChildren()) do
                            if item:IsA("Tool") then
                                if isAll or blacklistSelectedTools[item.Name] then
                                    shouldClearServer = true
                                    pcall(function()
                                        item.Parent = workspace
                                        item:Destroy()
                                    end)
                                end
                            end
                        end
                    end

                    if shouldClearServer and not isAll then
                        ClearTools:FireServer(player.Name)
                    end
                end
            end
        end
        task.wait(0.08)
    end
end)

local SettingsTab = Window:CreateTab("Settings", 4483362458)
SettingsTab:CreateSection("Custom Inventory")

SettingsTab:CreateToggle({
    Name = "ClearCustomInventory",
    CurrentValue = false,
    Flag = "ClearCustomInventoryToggle",
    Callback = function(Value)
        autoClearCustomInventoryUI = Value
        if Value then
            destroyCustomInventoryUI()
        end
    end
})

task.spawn(function()
    while true do
        if autoClearCustomInventoryUI then
            destroyCustomInventoryUI()
        end
        task.wait(0.1)
    end
end)

local function updateAllPlayerDropdowns()
    local updatedNames = getPlayerNames()
    if GivePlayerDropdown and GivePlayerDropdown.Refresh then pcall(function() GivePlayerDropdown:Refresh(updatedNames, true) end) end
    if RemovePlayerDropdown and RemovePlayerDropdown.Refresh then pcall(function() RemovePlayerDropdown:Refresh(updatedNames, true) end) end
    if UsePlayerDropdown and UsePlayerDropdown.Refresh then pcall(function() UsePlayerDropdown:Refresh(updatedNames, true) end) end
    if BlacklistWhiteListDropdown and BlacklistWhiteListDropdown.Refresh then
        local currentSelected = {}
        for name, state in pairs(blacklistWhiteListPlayers) do
            if state then table.insert(currentSelected, name) end
        end
        pcall(function()
            BlacklistWhiteListDropdown:Refresh(updatedNames, false)
            BlacklistWhiteListDropdown:Set(currentSelected)
        end)
    end
    if TrollPlayerDropdown and TrollPlayerDropdown.Refresh then
        pcall(function()
            TrollPlayerDropdown:Refresh(getTrollPlayerOptions(), false)
        end)
    end
    refreshRemoveToolsDropdown()
    refreshUseToolsDropdown("")
end

local refreshDebounce = false
local function scheduleInventoryRefresh()
    if refreshDebounce then return end
    refreshDebounce = true
    task.delay(0.5, function()
        refreshDebounce = false
        refreshUseToolsDropdown("")
        refreshRemoveToolsDropdown()
    end)
end

local function setupInventoryListeners()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if bp then
        bp.ChildAdded:Connect(function(item)
            if item:IsA("Tool") and not item:GetAttribute("IsSpamTool") then
                scheduleInventoryRefresh()
            end
        end)
        bp.ChildRemoved:Connect(function(item)
            if item:IsA("Tool") and not item:GetAttribute("IsSpamTool") then
                scheduleInventoryRefresh()
            end
        end)
    end
    if LocalPlayer.Character then
        LocalPlayer.Character.ChildAdded:Connect(function(item)
            if item:IsA("Tool") and not item:GetAttribute("IsSpamTool") then
                scheduleInventoryRefresh()
            end
        end)
        LocalPlayer.Character.ChildRemoved:Connect(function(item)
            if item:IsA("Tool") and not item:GetAttribute("IsSpamTool") then
                scheduleInventoryRefresh()
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    setupInventoryListeners()
    refreshUseToolsDropdown("")
    refreshRemoveToolsDropdown()
end)

setupInventoryListeners()

Players.PlayerAdded:Connect(function()
    task.wait(0.5)
    updateAllPlayerDropdowns()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.5)
    updateAllPlayerDropdowns()
end)
