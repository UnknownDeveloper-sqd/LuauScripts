local Rayfield = loadstring(game:HttpGet("https://github.com/UnknownDeveloper-sqd/UnknownSquad-RayField-Lib/raw/refs/heads/main/Rayfield/CustomRayfield.luau"))()

local Window = Rayfield:CreateWindow({
    Name = "BriskSurv | SomeCheats",
    LoadingTitle = "BriskSurv | SomeCheats",
    LoadingSubtitle = "By: UnknownSquad",
    Theme = "Amethyst",
    Width = 460,
    Height = 360,
    Font = "Code",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local CombatTab = Window:CreateTab("Combat", 4483362458)
local VisualsTab = Window:CreateTab("Visuals", 4483362458)

local lp = game.Players.LocalPlayer
local plrs = game:GetService("Players")
local rs = game:GetService("RunService")
local uis = game:GetService("UserInputService")
local wp = workspace:WaitForChild("HarvestWeakPoints")

local meleeAura = false
local autoCross = false
local silentAim = false
local playerEsp = false

local unpack = table.unpack or unpack
local newc = newcclosure or function(f) return f end
local check = checkcaller or function() return false end

CombatTab:CreateToggle({
    Name = "MeleeAura",
    CurrentValue = false,
    Callback = function(v)
        meleeAura = v
    end
})

CombatTab:CreateToggle({
    Name = "AutoCross",
    CurrentValue = false,
    Callback = function(v)
        autoCross = v
    end
})

CombatTab:CreateToggle({
    Name = "SilentAim",
    CurrentValue = false,
    Callback = function(v)
        silentAim = v
    end
})

VisualsTab:CreateToggle({
    Name = "PlayerESP",
    CurrentValue = false,
    Callback = function(v)
        playerEsp = v
    end
})

local function getBestCross()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not wp then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local best = nil
    local bestDot = 0.3
    local cPos = cam.CFrame.Position
    local cLook = cam.CFrame.LookVector
    local rPos = root.Position
    local pts = wp:GetChildren()
    for i = 1, #pts do
        local pt = pts[i]
        local p = pt:FindFirstChild("SlashA") or pt:FindFirstChild("Spark1") or pt:FindFirstChildWhichIsA("BasePart")
        if p then
            local pPos = p.Position
            if (rPos - pPos).Magnitude <= 15 then
                local dir = (pPos - cPos).Unit
                local dot = cLook:Dot(dir)
                if dot > bestDot then
                    bestDot = dot
                    best = p
                end
            end
        end
    end
    return best
end

local function getMeleeTarget()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best = nil
    local minDist = 12
    local rPos = root.Position
    local all = plrs:GetPlayers()
    for i = 1, #all do
        local p = all[i]
        if p ~= lp and p.Character then
            local hum = p.Character:FindFirstChild("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if head and hum and hum.Health > 0 then
                local d = (rPos - head.Position).Magnitude
                if d < minDist then
                    minDist = d
                    best = head
                end
            end
        end
    end
    return best
end

local function getGunTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local best = nil
    local minDist = 1000
    local cursorPos = uis:GetMouseLocation()
    local all = plrs:GetPlayers()
    for i = 1, #all do
        local p = all[i]
        if p ~= lp and p.Character then
            local hum = p.Character:FindFirstChild("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if head and hum and hum.Health > 0 then
                local sPos, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen then
                    local d = (Vector2.new(sPos.X, sPos.Y) - cursorPos).Magnitude
                    if d < minDist then
                        minDist = d
                        best = head
                    end
                end
            end
        end
    end
    return best
end

local guiParent = (gethui and gethui())
if not guiParent then
    local s, res = pcall(function() return game:GetService("CoreGui") end)
    guiParent = (s and res) or lp:WaitForChild("PlayerGui")
end

local espFolder = Instance.new("Folder")
espFolder.Name = "ESPFolder"
espFolder.Parent = guiParent
local espCache = {}

local function updatePlayerEsp()
    if not playerEsp then
        for p, hl in pairs(espCache) do
            hl:Destroy()
            espCache[p] = nil
        end
        return
    end
    local all = plrs:GetPlayers()
    for i = 1, #all do
        local p = all[i]
        if p ~= lp and p.Character then
            local hum = p.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local hl = espCache[p]
                if not hl or hl.Parent ~= espFolder then
                    hl = Instance.new("Highlight")
                    hl.Adornee = p.Character
                    hl.FillColor = Color3.fromRGB(255, 60, 60)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = espFolder
                    espCache[p] = hl
                else
                    hl.Adornee = p.Character
                end
            elseif espCache[p] then
                espCache[p]:Destroy()
                espCache[p] = nil
            end
        elseif espCache[p] then
            espCache[p]:Destroy()
            espCache[p] = nil
        end
    end
end

local lastEsp = 0
rs.RenderStepped:Connect(function()
    local now = os.clock()
    if now - lastEsp > 0.25 then
        lastEsp = now
        updatePlayerEsp()
    end
end)

local oldNamecall
local oldIndex

local function namecallHook(self, ...)
    local rawMethod = getnamecallmethod and getnamecallmethod()
    local method = rawMethod and rawMethod:lower() or ""
    local args = {...}
    if not check() then
        if method == "fireserver" then
            if self.Name == "HammerMeleeRemote" then
                if meleeAura then
                    local target = getMeleeTarget()
                    if target and typeof(args[2]) == "Vector3" then
                        local vel = target.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                        local targetPos = target.Position + vel * 0.04 + Vector3.new(0, 0.12, 0)
                        args[3] = (targetPos - args[2]).Unit
                        return self.FireServer(self, unpack(args))
                    end
                end
                if autoCross then
                    local cross = getBestCross()
                    if cross and typeof(args[2]) == "Vector3" then
                        args[3] = (cross.Position - args[2]).Unit
                        return self.FireServer(self, unpack(args))
                    end
                end
            elseif self.Name == "GunFire" and silentAim then
                local target = getGunTarget()
                if target and typeof(args[2]) == "Vector3" then
                    local vel = target.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                    local targetPos = target.Position + vel * 0.04 + Vector3.new(0, 0.12, 0)
                    args[3] = (targetPos - args[2]).Unit
                    return self.FireServer(self, unpack(args))
                end
            end
        elseif method == "raycast" and silentAim then
            local target = getGunTarget()
            if target and typeof(args[1]) == "Vector3" then
                local vel = target.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                local targetPos = target.Position + vel * 0.04 + Vector3.new(0, 0.12, 0)
                args[2] = (targetPos - args[1]).Unit * 1200
                if setnamecallmethod and rawMethod then
                    setnamecallmethod(rawMethod)
                end
                return oldNamecall(self, unpack(args))
            end
        end
    end
    if setnamecallmethod and rawMethod then
        setnamecallmethod(rawMethod)
    end
    return oldNamecall(self, ...)
end

local function indexHook(self, key)
    if not check() and silentAim and self:IsA("Mouse") and (key == "Hit" or key == "Target") then
        local target = getGunTarget()
        if target then
            return (key == "Hit" and CFrame.new(target.Position)) or target
        end
    end
    return oldIndex(self, key)
end

if hookmetamethod then
    oldNamecall = hookmetamethod(game, "__namecall", newc(namecallHook))
    oldIndex = hookmetamethod(game, "__index", newc(indexHook))
else
    local mt = getrawmetatable(game)
    oldNamecall = mt.__namecall
    oldIndex = mt.__index
    setreadonly(mt, false)
    mt.__namecall = newc(namecallHook)
    mt.__index = newc(indexHook)
    setreadonly(mt, true)
end
